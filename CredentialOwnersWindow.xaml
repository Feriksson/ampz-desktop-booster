<Window x:Class="AmpzDesktopBooster.CredentialOwnersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate CredOwners.WindowTitle}"
        Width="520" Height="480"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <!-- Hijo del gestor de credenciales, mismo piso visual que CredentialLinkPickerWindow. Topmost
         como los demás diálogos de credenciales: el renombre abre PromptDialog (Topmost) encima. -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center" />
                                <Border x:Name="Keycap" Margin="8,0,0,0" Padding="4,0,4,1"
                                        CornerRadius="3" VerticalAlignment="Center"
                                        Background="#1A1A1A" BorderBrush="#4A4A52" BorderThickness="1">
                                    <TextBlock x:Name="KeycapText" FontFamily="Consolas" FontSize="10"
                                               Foreground="#9A9A9A"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Keycap" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34505C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E6E6EA" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262626" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Foreground="#F2F2F2" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"
                       Text="{loc:Translate CredOwners.Header}" TextWrapping="Wrap" />

            <Border Grid.Row="1" Background="#161616" CornerRadius="4" Padding="2">
                <Grid>
                    <ListBox x:Name="OwnerList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E6E6EA"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#8A8A92" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Vacío: dice cómo se carga el primero (nunca una lista en blanco). -->
                    <TextBlock x:Name="EmptyText" Visibility="Collapsed" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                               TextAlignment="Center" TextWrapping="Wrap" Foreground="#8A8A92" FontSize="12"
                               Text="{loc:Translate CredOwners.Empty}" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="2" Foreground="#6E6E78" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="{loc:Translate CredOwners.Hint}" />

            <!-- Por qué una acción no hizo nada (nombre repetido, nada elegido): a la vista. -->
            <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="#E06C75" FontSize="12" Margin="0,6,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <WrapPanel Grid.Row="4" Margin="0,10,0,0" HorizontalAlignment="Right">
                <Button x:Name="AddBtn"    Content="{loc:Translate Creds.BtnAdd}" Tag="{loc:Translate Keys.CtrlN}" Margin="0,0,6,0" />
                <Button x:Name="RenameBtn" Content="{loc:Translate CredOwners.BtnRename}" Tag="{loc:Translate Keys.F2}" Margin="0,0,6,0" />
                <Button x:Name="DeleteBtn" Content="{loc:Translate Creds.BtnDelete}" Tag="{loc:Translate Keys.Delete}" Margin="0,0,6,0" />
                <Button x:Name="CloseBtn"  Content="{loc:Translate Creds.BtnClose}" Tag="{loc:Translate Keys.Escape}" MinWidth="90" />
            </WrapPanel>
        </Grid>
    </Border>
</Window>
