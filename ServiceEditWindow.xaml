<Window x:Class="AmpzDesktopBooster.ServiceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate Services.DlgTitle}"
        Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34505C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox oscuro: mismo template que VariableEditWindow / LooseNoteDialog (el default
             pinta el área de selección con el blanco del sistema e ignora Background/Foreground). -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#2A2A2A" CornerRadius="3" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border IsHitTestVisible="False" CornerRadius="3" BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path Grid.Column="1" Fill="#F2F2F2" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" Data="M 0 0 L 8 0 L 4 5 Z" />
                                </Grid>
                            </Border>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="#2A2A2A" BorderBrush="#444" BorderThickness="1" CornerRadius="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4FC3F7" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3C3C3C" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D4A57" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Foreground="#F2F2F2" FontSize="14"
                       FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBlock x:Name="ScopeText" Margin="0,0,0,12" />

            <!-- Dónde se guarda: SÓLO en un alta con catálogo (ver ScopePicker y el gemelo en
                 VariableEditWindow). Editar no cambia de scope: eso es MOVER, y vive en la config. -->
            <Grid x:Name="ScopePickerPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Translate Scope.FldSpace}" />
                    <ComboBox x:Name="SpaceCombo" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Translate Scope.FldContext}" />
                    <ComboBox x:Name="ContextCombo" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{loc:Translate Services.FldTitle}" />
            <TextBox x:Name="TitleBox" />

            <TextBlock Text="{loc:Translate Services.FldWorkDir}" />
            <TextBox x:Name="WorkDirBox" />

            <TextBlock Text="{loc:Translate Services.FldCommand}" />
            <TextBox x:Name="CommandBox" Margin="0,0,0,4" />

            <!-- Los atajos {ip}/{port} se anuncian ACÁ, pegados al campo donde se escriben: un token
                 que no se puede descubrir no existe. El preview de abajo aparece sólo si los usás. -->
            <TextBlock Text="{loc:Translate Services.TokensHint}" TextWrapping="Wrap"
                       Foreground="#6E6E78" FontSize="10" Margin="0,0,0,4" />
            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontSize="11"
                       FontFamily="Consolas" Foreground="#7FB8D4"
                       Visibility="Collapsed" Margin="0,0,0,10" />

            <TextBlock Text="{loc:Translate Services.FldPort}" />
            <TextBox x:Name="PortBox" Margin="0,0,0,4" />


            <!-- El choque de puerto se avisa MIENTRAS tipeás, no recién al aceptar: enterarte de que
                 el 3000 está tomado después de cargar los cuatro campos es enterarte tarde. El
                 MessageBox de Aceptar queda igual como red (podés no mirar acá), pero el camino
                 normal es que nunca lo veas. -->
            <TextBlock x:Name="PortConflictText" TextWrapping="Wrap" FontSize="11"
                       Foreground="#E5A0A0" Visibility="Collapsed" Margin="0,0,0,10" />
            <!-- La URL va DESPUÉS del puerto a propósito: lo más común es escribirla apoyándose en
                 el puerto que acabás de cargar ("localhost:6080/platform"), y el atajo de abajo la
                 completa sola con ese número. Ponerla antes obligaría a saltar hacia adelante. -->
            <TextBlock Text="{loc:Translate Services.FldUrl}" Margin="0,8,0,3" />
            <TextBox x:Name="UrlBox" Margin="0,0,0,4" />
            <TextBlock x:Name="UrlHint" TextWrapping="Wrap" FontSize="10"
                       Foreground="#6E6E78" Margin="0,0,0,10" />

            <!-- Tri-estado REAL (IsThreeState): tildado / destildado / indeterminado = "seguí el
                 default según el puerto". Sin el tercer estado, abrir y aceptar el diálogo sin tocar
                 nada congelaría una decisión que el usuario nunca tomó. -->
            <CheckBox x:Name="AutoStartBox" IsThreeState="True" Foreground="#E6E6EA" FontSize="12"
                      Content="{loc:Translate Services.FldAutoStart}" Margin="0,2,0,4" />
            <TextBlock x:Name="AutoStartHint" Foreground="#6E6E78" FontSize="10"
                       TextWrapping="Wrap" Margin="0,0,0,6" />

            <!-- Sólo tiene sentido si hay un COMANDO que corre en una terminal (una entrada sin
                 comando no abre pestaña ninguna) — se oculta/muestra en código atado a CommandBox. -->
            <CheckBox x:Name="CloseOnExitBox" Foreground="#E6E6EA" FontSize="12"
                      Content="{loc:Translate Services.FldCloseOnExit}" Margin="0,2,0,4" />
            <TextBlock x:Name="CloseOnExitHint" Text="{loc:Translate Services.CloseOnExitHint}"
                       Foreground="#6E6E78" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6" />

            <!-- Misma regla de visibilidad que el de arriba: sin comando no hay terminal que elevar.
                 Destildado por defecto a propósito — la app corre elevada y lo que lanza NO debe
                 heredarlo salvo que se pida acá (o por lanzada, con Ctrl+Shift+Enter). -->
            <CheckBox x:Name="RunElevatedBox" Foreground="#E6E6EA" FontSize="12"
                      Content="{loc:Translate Services.FldRunElevated}" Margin="0,2,0,4" />
            <TextBlock x:Name="RunElevatedHint" Text="{loc:Translate Services.RunElevatedHint}"
                       Foreground="#6E6E78" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6" />

            <TextBlock Text="{loc:Translate Services.DlgHint}" TextWrapping="Wrap"
                       Foreground="#6E6E78" FontSize="10" Margin="0,2,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="OkBtn" Content="{loc:Translate Prompt.Ok}" MinWidth="90"
                        Margin="0,0,6,0" Padding="10,4" IsDefault="True" />
                <Button x:Name="CancelBtn" Content="{loc:Translate Prompt.Cancel}" MinWidth="90"
                        Padding="10,4" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
