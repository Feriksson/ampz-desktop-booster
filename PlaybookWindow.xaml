<Window x:Class="AmpzDesktopBooster.PlaybookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate Playbook.WindowTitle}"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- ── Paleta ── La de facto de las ventanas utilitarias, definida UNA vez acá.
             OJO con el gris de pista (#6E6E78) que usan otras ventanas para sus hints: sobre estos
             fondos da ~3,3:1, por debajo del 4,5:1 que se le pide al texto. Por eso acá TODO texto
             secundario (placeholder, pista de teclas, conteos) usa MutedBrush (#9A9A9A, ≥5:1 sobre
             los tres fondos) y ese gris no se usa para letras. -->
        <SolidColorBrush x:Key="BgBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161616" />
        <SolidColorBrush x:Key="InputBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="LineBrush" Color="#444444" />
        <SolidColorBrush x:Key="SoftLineBrush" Color="#333333" />
        <SolidColorBrush x:Key="FgBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9A9A9A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4FC3F7" />
        <SolidColorBrush x:Key="GoldBrush" Color="#FFD700" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E5534B" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#26404C" />
        <!-- La fila elegida de la lista usa un relleno MÁS oscuro que el de arriba: sobre #26404C el
             texto secundario (conteo, solidez) quedaba en 3,9:1; acá da 4,7:1. Como el relleno solo
             se distingue poco del fondo, la fila elegida lleva además una marca de acento a la
             izquierda — la selección no depende de notar un cambio de tono. -->
        <SolidColorBrush x:Key="SelectedRowBrush" Color="#1E333D" />
        <SolidColorBrush x:Key="HoverBrush" Color="#242424" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#262626" />
        <!-- Tinta de las teclas dibujadas sobre un color de respuesta: oscura, porque los cuatro
             colores son claros (≥4,8:1 con esta tinta; con letra blanca el rojo no llegaba). -->
        <SolidColorBrush x:Key="InkBrush" Color="#161616" />
        <!-- Las cuatro respuestas, de peor a mejor: rojo → naranja → amarillo → verde. El color es
             un REFUERZO: cada una lleva además su número y su texto, que es lo que se lee. -->
        <SolidColorBrush x:Key="Grade1Brush" Color="#E5534B" />
        <SolidColorBrush x:Key="Grade2Brush" Color="#F0A04B" />
        <SolidColorBrush x:Key="Grade3Brush" Color="#E6D25A" />
        <SolidColorBrush x:Key="Grade4Brush" Color="#5FD38D" />

        <!-- Tecla dibujada ("keycap"): cómo se muestra CADA atajo de esta ventana. Texto, no ícono. -->
        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="#5A5A5A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeycapText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Botón común. El borde mide SIEMPRE 2px (gris en reposo, acento con foco de teclado):
             así el anillo de foco no corre el contenido un píxel al aparecer. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F3D45" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de RESPUESTA (1..4). Los cuatro miden lo mismo (los reparte un UniformGrid) y se
             distinguen por número + texto + la franja de color de abajo (BorderBrush de cada uno).
             Tag="flash" es el destello de "anotado": lo prende y apaga el code-behind (~120 ms). -->
        <Style x:Key="GradeButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" BorderBrush="Transparent" BorderThickness="2" CornerRadius="9">
                            <Grid>
                                <Border x:Name="Bd" Background="#232323" CornerRadius="7"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,4"
                                        Padding="14,6">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <Border x:Name="Flash" Background="#40FFFFFF" CornerRadius="7"
                                        Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E2E" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="flash">
                                <Setter TargetName="Flash" Property="Opacity" Value="1" />
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource FgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmento del grupo "qué lado se muestra primero": RadioButtons que se ven como una sola
             tira. Elegido = relleno + letra clara y en negrita (no sólo un cambio de tono);
             foco de teclado = anillo de acento, que es una señal distinta de "elegido". -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2" CornerRadius="6" Padding="12,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila de la lista. La SELECCIONADA (lo que elige Enter) se rellena; la que tiene el foco
             de teclado suma el anillo. Reemplaza el rectángulo azul por defecto del ListBoxItem. -->
        <Style x:Key="PickRowContainer" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2" CornerRadius="6" Margin="0,1">
                            <Grid>
                                <Border x:Name="Mark" Width="3" CornerRadius="2" Margin="2,5,0,5"
                                        HorizontalAlignment="Left" Visibility="Hidden"
                                        Background="{StaticResource AccentBrush}" />
                                <ContentPresenter Margin="14,9,12,9" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Contenido de una fila: [chip de naturaleza] camino › nombre ……… conteo · barra · solidez.
             La barra y el chip traen su Visibility desde la fila (ver PickRow): una biblioteca sin
             jugar NO muestra una barra en cero, muestra el texto "sin jugar". -->
        <DataTemplate x:Key="PickRowTemplate">
            <Grid Margin="{Binding Indent}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Visibility="{Binding ChipVisibility}" Margin="0,0,8,0"
                        BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="9"
                        Padding="7,1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Translate Playbook.NatureChip}" FontSize="12"
                               Foreground="{StaticResource GoldBrush}" />
                </Border>
                <TextBlock Grid.Column="1" FontSize="16" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding PathPrefix, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding Name, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="14" Margin="12,0,0,0"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <Border Grid.Column="3" Visibility="{Binding BarVisibility}" Width="110" Height="7"
                        Margin="14,0,0,0" CornerRadius="3" Background="{StaticResource SoftLineBrush}"
                        VerticalAlignment="Center">
                    <Border HorizontalAlignment="Left" Width="{Binding BarFillWidth}" CornerRadius="3"
                            Background="{StaticResource AccentBrush}" />
                </Border>
                <TextBlock Grid.Column="4" Text="{Binding SolidityText}" FontSize="14" Margin="10,0,0,0"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CaretBrush" Value="{StaticResource FgBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- TODO lo que se ve cuelga de RootBorder, que el code-behind ESCALA entero según el alto de la
         ventana (ver ApplyScale). Por eso las medidas de este archivo están pensadas para UN alto de
         referencia (972 = el 90% de una pantalla de 1080) y no hay que adaptarlas a otras pantallas.

         Las vistas no se estiran de punta a punta: cada una tiene un ancho máximo y queda centrada
         (un elemento con MaxWidth y alineación Stretch se centra solo). La ventana ocupa el 90% de la
         pantalla para que la tarjeta entre ENTERA sin scroll, no para leer renglones de 1700px. -->
    <Border x:Name="RootBorder" CornerRadius="12" Background="{StaticResource BgBrush}" BorderBrush="#2EFFFFFF"
            BorderThickness="1" Padding="32,22" TextElement.Foreground="{StaticResource FgBrush}">
        <Border.Resources>
            <!-- Barra de scroll oscura y fina para la lista y para la tarjeta: la clara por defecto
                 era una franja blanca sobre el panel oscuro. Estilo implícito, compartido. -->
            <ResourceDictionary Source="/AmpzDesktopBooster;component/Themes/DarkScrollBar.xaml" />
        </Border.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado: qué se está jugando + avance + cerrar. También es la manija para arrastrar
                 la ventana (queda Topmost durante una sesión larga: hay que poder correrla). -->
            <Grid x:Name="HeaderBar" Grid.Row="0" Margin="0,0,0,14" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Grid.Column="0" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ProgressText" Grid.Column="1" FontSize="18" FontFamily="Consolas"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                           Margin="12,0,16,0" Visibility="Collapsed" />
                <Button x:Name="CloseBtn" Grid.Column="2" Height="34"
                        Content="{loc:Translate Playbook.Close}" />
            </Grid>

            <!-- ═══ 1 · BÚSQUEDA ═══ -->
            <Grid x:Name="SearchView" Grid.Row="1" MaxWidth="1040">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBox x:Name="SearchBox" FontSize="17" Height="46"
                             AutomationProperties.Name="{loc:Translate Playbook.SearchLabel}" />
                    <TextBlock x:Name="SearchPlaceholder" IsHitTestVisible="False"
                               Text="{loc:Translate Playbook.SearchPlaceholder}"
                               Foreground="{StaticResource MutedBrush}" FontSize="17"
                               VerticalAlignment="Center" Margin="11,0,0,0" />
                </Grid>
                <ListBox x:Name="PickList" Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                         BorderBrush="{StaticResource SoftLineBrush}" BorderThickness="1" Padding="4"
                         ItemTemplate="{StaticResource PickRowTemplate}"
                         ItemContainerStyle="{StaticResource PickRowContainer}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{loc:Translate Playbook.ListLabel}" />
                <!-- Estados vacíos (sin bibliotecas / sin coincidencias): encima de la lista, nunca
                     una lista en blanco sin explicación. -->
                <TextBlock x:Name="EmptyText" Grid.Row="1" Visibility="Collapsed" FontSize="16"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="520" IsHitTestVisible="False" />
            </Grid>

            <!-- ═══ 2 · ARMADO: qué elegiste y qué lado se muestra primero ═══ -->
            <StackPanel x:Name="SetupView" Grid.Row="1" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Width="700">
                <TextBlock x:Name="SetupKind" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="SetupName" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap"
                           Margin="0,2,0,4" />
                <TextBlock x:Name="SetupCount" FontSize="16" Foreground="{StaticResource MutedBrush}" />

                <TextBlock x:Name="SideGroupLabel" Text="{loc:Translate Playbook.SetupQuestion}"
                           FontSize="16" Margin="0,32,0,10" />
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="3">
                    <UniformGrid Columns="3" AutomationProperties.Name="{loc:Translate Playbook.SetupQuestion}">
                        <RadioButton x:Name="SideFrontRadio" GroupName="PlaybookSide" Style="{StaticResource Segment}"
                                     AutomationProperties.Name="{loc:Translate Playbook.SideFront}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Keycap}" Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource KeycapText}" Text="1" />
                                </Border>
                                <TextBlock Text="{loc:Translate Playbook.SideFront}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="SideBackRadio" GroupName="PlaybookSide" Style="{StaticResource Segment}"
                                     AutomationProperties.Name="{loc:Translate Playbook.SideBack}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Keycap}" Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource KeycapText}" Text="2" />
                                </Border>
                                <TextBlock Text="{loc:Translate Playbook.SideBack}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="SideMixedRadio" GroupName="PlaybookSide" Style="{StaticResource Segment}"
                                     AutomationProperties.Name="{loc:Translate Playbook.SideMixed}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Keycap}" Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource KeycapText}" Text="3" />
                                </Border>
                                <TextBlock Text="{loc:Translate Playbook.SideMixed}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Border>

                <!-- El motivo por el que no se puede empezar va A LA VISTA, al lado del botón apagado:
                     un botón gris sin explicación se lee igual que uno roto. -->
                <Border x:Name="StartReason" Visibility="Collapsed" Margin="0,22,0,0" Padding="12,8"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource GoldBrush}"
                        BorderThickness="3,0,0,0" CornerRadius="4">
                    <TextBlock Text="{loc:Translate Playbook.NoEntriesReason}" FontSize="15" TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button x:Name="StartBtn" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate Playbook.Start}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Style="{StaticResource Keycap}">
                                <TextBlock Style="{StaticResource KeycapText}" Text="Enter" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SetupBackBtn">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate Playbook.Back}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Style="{StaticResource Keycap}">
                                <TextBlock Style="{StaticResource KeycapText}" Text="Esc" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- ═══ 3 · QUIZ ═══ -->
            <Grid x:Name="QuizView" Grid.Row="1" Visibility="Collapsed" MaxWidth="1320">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- De qué tarjeta se trata: lado mostrado a la izquierda; biblioteca y naturaleza a la derecha. -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ShownSideText" Grid.Column="0" FontSize="14"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CardPathText" Grid.Column="1" FontSize="14" Margin="16,0,0,0"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    <Border x:Name="CardNatureChip" Grid.Column="2" Margin="10,0,0,0" Padding="7,1"
                            BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="9"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CardNatureText" FontSize="13" Foreground="{StaticResource GoldBrush}" />
                    </Border>
                </Grid>

                <!-- La tarjeta. Una tarjeta o un término con su ficha completa tiene que ENTRAR ENTERO,
                     sin scroll: para eso la ventana es grande y el texto va en una columna de ancho de
                     lectura (CardPanel), centrada a lo ancho y a lo alto, en vez de correr de borde a
                     borde. El ScrollViewer queda sólo de RED para un texto desmesurado: ahí envuelve y
                     scrollea acá adentro (con la barra oscura), así nunca se recorta nada. Es enfocable
                     a propósito — durante el quiz el foco vive acá, y si hiciera falta ↑ ↓ / RePág AvPág
                     mueven el texto. -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="10" BorderThickness="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource SoftLineBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=CardScroll}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer x:Name="CardScroll" Focusable="True" FocusVisualStyle="{x:Null}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="44,26">
                        <StackPanel x:Name="CardPanel" MaxWidth="940" VerticalAlignment="Center" />
                    </ScrollViewer>
                </Border>

                <!-- Bajo la tarjeta: solidez de este lado (recién tras revelar) y el aviso de guardado.
                     Alto fijo: aparecer o desaparecer no hace saltar los botones de abajo. -->
                <Grid Grid.Row="2" Height="36" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CardSolidityText" Grid.Column="0" FontSize="15"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <Border x:Name="SaveNotice" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Right"
                            Padding="10,4" Background="{StaticResource SurfaceBrush}" CornerRadius="4"
                            BorderBrush="{StaticResource DangerBrush}" BorderThickness="3,0,0,0">
                        <TextBlock Text="{loc:Translate Playbook.SaveFailed}" FontSize="14" />
                    </Border>
                </Grid>

                <!-- Acciones. Antes de revelar: un solo botón. Después: las cuatro respuestas, todas
                     del mismo tamaño, más "siguiente sin responder". Mismo alto en los dos estados. -->
                <Grid Grid.Row="3" Height="76">
                    <Button x:Name="RevealBtn" Height="56" HorizontalAlignment="Center" Padding="30,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate Playbook.Reveal}" VerticalAlignment="Center"
                                       FontSize="17" Margin="0,0,12,0" />
                            <Border Style="{StaticResource Keycap}">
                                <TextBlock Style="{StaticResource KeycapText}" Text="{loc:Translate Playbook.KeySpace}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Grid x:Name="GradePanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <UniformGrid Grid.Column="0" Columns="4" Margin="-4,0,0,0">
                            <Button x:Name="Grade1Btn" Style="{StaticResource GradeButton}"
                                    BorderBrush="{StaticResource Grade1Brush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="5" Margin="0,0,10,0"
                                            Background="{StaticResource Grade1Brush}" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource KeycapText}" Text="1" FontWeight="Bold"
                                                   Foreground="{StaticResource InkBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Translate Playbook.Grade1}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="Grade2Btn" Style="{StaticResource GradeButton}"
                                    BorderBrush="{StaticResource Grade2Brush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="5" Margin="0,0,10,0"
                                            Background="{StaticResource Grade2Brush}" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource KeycapText}" Text="2" FontWeight="Bold"
                                                   Foreground="{StaticResource InkBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Translate Playbook.Grade2}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="Grade3Btn" Style="{StaticResource GradeButton}"
                                    BorderBrush="{StaticResource Grade3Brush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="5" Margin="0,0,10,0"
                                            Background="{StaticResource Grade3Brush}" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource KeycapText}" Text="3" FontWeight="Bold"
                                                   Foreground="{StaticResource InkBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Translate Playbook.Grade3}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="Grade4Btn" Style="{StaticResource GradeButton}"
                                    BorderBrush="{StaticResource Grade4Brush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="5" Margin="0,0,10,0"
                                            Background="{StaticResource Grade4Brush}" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource KeycapText}" Text="4" FontWeight="Bold"
                                                   Foreground="{StaticResource InkBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Translate Playbook.Grade4}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </UniformGrid>
                        <Button x:Name="SkipBtn" Grid.Column="1" Height="56" Margin="10,0,0,0"
                                AutomationProperties.Name="{loc:Translate Playbook.SkipAccessible}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Translate Playbook.Skip}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Border Style="{StaticResource Keycap}">
                                    <TextBlock Style="{StaticResource KeycapText}" Text="{loc:Translate Playbook.KeySpace}" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ═══ 4 · RESUMEN de la ronda ═══ -->
            <StackPanel x:Name="SummaryView" Grid.Row="1" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Width="860">
                <TextBlock Text="{loc:Translate Playbook.SummaryTitle}" FontSize="34" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryCounts" FontSize="16" Margin="0,8,0,22"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

                <!-- Una casilla por respuesta, con el MISMO número, texto y color que su botón del quiz. -->
                <UniformGrid Columns="4" Margin="-4,0">
                    <Border Margin="4,0" Padding="16,14" Background="{StaticResource SurfaceBrush}" CornerRadius="7"
                            BorderBrush="{StaticResource Grade1Brush}" BorderThickness="0,0,0,4">
                        <StackPanel>
                            <TextBlock x:Name="SummaryGrade1" FontSize="38" FontWeight="SemiBold" />
                            <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}">
                                <Run Text="1 ·" /> <Run Text="{loc:Translate Playbook.Grade1}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Margin="4,0" Padding="16,14" Background="{StaticResource SurfaceBrush}" CornerRadius="7"
                            BorderBrush="{StaticResource Grade2Brush}" BorderThickness="0,0,0,4">
                        <StackPanel>
                            <TextBlock x:Name="SummaryGrade2" FontSize="38" FontWeight="SemiBold" />
                            <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}">
                                <Run Text="2 ·" /> <Run Text="{loc:Translate Playbook.Grade2}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Margin="4,0" Padding="16,14" Background="{StaticResource SurfaceBrush}" CornerRadius="7"
                            BorderBrush="{StaticResource Grade3Brush}" BorderThickness="0,0,0,4">
                        <StackPanel>
                            <TextBlock x:Name="SummaryGrade3" FontSize="38" FontWeight="SemiBold" />
                            <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}">
                                <Run Text="3 ·" /> <Run Text="{loc:Translate Playbook.Grade3}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Margin="4,0" Padding="16,14" Background="{StaticResource SurfaceBrush}" CornerRadius="7"
                            BorderBrush="{StaticResource Grade4Brush}" BorderThickness="0,0,0,4">
                        <StackPanel>
                            <TextBlock x:Name="SummaryGrade4" FontSize="38" FontWeight="SemiBold" />
                            <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}">
                                <Run Text="4 ·" /> <Run Text="{loc:Translate Playbook.Grade4}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock x:Name="SummarySolidity" FontSize="20" Margin="0,26,0,0" TextWrapping="Wrap" />
                <Border x:Name="SummaryUnsaved" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,8"
                        Background="{StaticResource SurfaceBrush}" CornerRadius="4"
                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="3,0,0,0">
                    <TextBlock x:Name="SummaryUnsavedText" FontSize="15" TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                    <Button x:Name="PlayAgainBtn" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate Playbook.PlayAgain}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Style="{StaticResource Keycap}">
                                <TextBlock Style="{StaticResource KeycapText}" Text="Enter" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SummaryBackBtn">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate Playbook.BackToSearch}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Style="{StaticResource Keycap}">
                                <TextBlock Style="{StaticResource KeycapText}" Text="Esc" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Pista: SIEMPRE dice qué teclas valen en el paso actual (la cambia el code-behind). -->
            <TextBlock x:Name="HintText" Grid.Row="2" Margin="0,12,0,0" FontSize="14"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center" />
        </Grid>
    </Border>
</Window>
