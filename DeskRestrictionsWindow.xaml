<Window x:Class="AmpzDesktopBooster.DeskRestrictionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proteger escritorios"
        Width="500" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock Foreground="#F2F2F2" FontSize="16" FontWeight="SemiBold"
                       Text="Proteger escritorios" />
            <TextBlock Foreground="#9A9A9A" FontSize="11" Margin="0,4,0,10" TextWrapping="Wrap"
                       Text="Un escritorio protegido sólo admite las apps de su whitelist; el resto se manda a MAIN. Enter o doble clic activa/desactiva. (MAIN y los DESK +N no son protegibles.)" />

            <ListBox x:Name="DeskList" Height="220" Background="#161616" Foreground="#E6E6EA"
                     BorderBrush="#333" FontSize="13"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <TextBlock x:Name="EmptyHint" Foreground="#6E6E78" FontSize="11" Margin="0,6,0,0"
                       Text="No hay escritorios protegibles."
                       Visibility="Collapsed" />

            <TextBlock Foreground="#6E6E78" FontSize="10" Margin="0,8,0,0"
                       Text="Enter / doble clic: activar/desactivar · Esc: cerrar" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="ToggleBtn" Content="Activar / Desactivar" Width="160" Height="26" Margin="0,0,8,0" />
                <Button x:Name="CloseBtn" Content="Cerrar" Width="90" Height="26" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
