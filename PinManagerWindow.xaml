<Window x:Class="AmpzDesktopBooster.PinManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anclajes"
        Width="500" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock Foreground="#F2F2F2" FontSize="16" FontWeight="SemiBold"
                       Text="Procesos anclados" Margin="0,0,0,10" />

            <ListBox x:Name="PinList" Height="220" Background="#161616" Foreground="#E6E6EA"
                     BorderBrush="#333" FontSize="13"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <TextBlock x:Name="EmptyHint" Foreground="#6E6E78" FontSize="11" Margin="0,6,0,0"
                       Text="No hay procesos anclados. Anclá uno con Win+F6 sobre la ventana activa."
                       Visibility="Collapsed" />

            <TextBlock Foreground="#6E6E78" FontSize="10" Margin="0,8,0,0"
                       Text="Supr: desanclar el seleccionado · Esc: cerrar" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="UnpinAllBtn" Content="Desanclar todo" Width="130" Height="26" Margin="0,0,8,0" />
                <Button x:Name="CloseBtn" Content="Cerrar" Width="90" Height="26" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
