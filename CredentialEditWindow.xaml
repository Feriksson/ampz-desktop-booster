<Window x:Class="AmpzDesktopBooster.CredentialEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate CredEdit.DlgTitle}"
        Width="760" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <!-- Mismo piso visual que VariableEditWindow (su hermano para variables): TextBox, combo y
         botones oscuros, con el foco de teclado a la vista. -->
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="CaretBrush" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4FC3F7" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="CaretBrush" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4FC3F7" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E6EA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Botones con KEYCAP (Tag), como en CredentialsWindow. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center" />
                                <Border x:Name="Keycap" Margin="8,0,0,0" Padding="4,0,4,1"
                                        CornerRadius="3" VerticalAlignment="Center"
                                        Background="#1A1A1A" BorderBrush="#4A4A52" BorderThickness="1">
                                    <TextBlock x:Name="KeycapText" FontFamily="Consolas" FontSize="10"
                                               Foreground="#9A9A9A"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Keycap" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                                <Setter TargetName="Keycap" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34505C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox oscuro: mismo template que VariableEditWindow (el default ignora los colores). -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#2A2A2A" CornerRadius="3" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border IsHitTestVisible="False" CornerRadius="3" BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path Grid.Column="1" Fill="#F2F2F2" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" Data="M 0 0 L 8 0 L 4 5 Z" />
                                </Grid>
                            </Border>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="#2A2A2A" BorderBrush="#444" BorderThickness="1" CornerRadius="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4FC3F7" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3C3C3C" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D4A57" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Foreground="#F2F2F2" FontSize="14" FontWeight="SemiBold" />
            <!-- Dónde queda: se reescribe en vivo al tocar los combos ("Se guarda en" / "Se mueve a"). -->
            <TextBlock x:Name="ScopeText" Margin="0,2,0,6" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Translate Scope.FldSpace}" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="SpaceCombo" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Translate Scope.FldContext}" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ContextCombo" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{loc:Translate CredEdit.FldTitle}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TitleBox" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Translate CredEdit.FldUser}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="UserBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Translate CredEdit.FldUrl}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="UrlBox" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{loc:Translate CredEdit.FldPassword}" Style="{StaticResource FieldLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- El par PasswordBox/TextBox lo maneja SecretInput (code-behind): lo arma acá adentro. -->
                <ContentControl x:Name="PasswordHost" Focusable="False" />
                <Button Grid.Column="1" x:Name="RevealBtn" Content="{loc:Translate Creds.BtnReveal}"
                        Tag="{loc:Translate Keys.CtrlR}" MinWidth="110" Margin="8,0,0,0" />
            </Grid>

            <!-- Generador: largo + conjuntos + Generar, en un renglón. Lo que impide generar (largo
                 fuera de rango, ningún conjunto) se dice en GenStatus, al lado — nunca un botón mudo. -->
            <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="{loc:Translate CredEdit.GenLength}" VerticalAlignment="Center" FontSize="12"
                           Foreground="#C8C8CC" Margin="0,0,6,0" />
                <TextBox x:Name="LengthBox" Width="46" HorizontalContentAlignment="Center" Margin="0,0,14,0" />
                <CheckBox x:Name="UpperBox" Content="A–Z" IsChecked="True" Margin="0,0,12,0" />
                <CheckBox x:Name="LowerBox" Content="a–z" IsChecked="True" Margin="0,0,12,0" />
                <CheckBox x:Name="DigitsBox" Content="0–9" IsChecked="True" Margin="0,0,12,0" />
                <CheckBox x:Name="SymbolsBox" Content="!@#…" IsChecked="True" Margin="0,0,14,0" />
                <Button x:Name="GenerateBtn" Content="{loc:Translate CredEdit.BtnGenerate}" Tag="{loc:Translate Keys.CtrlG}" />
            </WrapPanel>
            <TextBlock x:Name="GenStatus" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

            <!-- Campos extra: cada fila se edita en el lugar (agregar suma una fila VACÍA editable; lo
                 que se ve es lo que se guarda, las filas vacías se descartan al guardar). -->
            <TextBlock Text="{loc:Translate CredEdit.FldFields}" Style="{StaticResource FieldLabel}" />
            <!-- Rótulos de columna: mismas medidas que las filas (200 | 8 | resto) armadas en código. -->
            <Grid x:Name="FieldsHeader" Visibility="Collapsed" Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Translate CredEdit.FieldName}" />
                <TextBlock Grid.Column="2" Text="{loc:Translate CredEdit.FieldValue}" />
            </Grid>
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FieldsPanel" Margin="0,0,4,0" />
            </ScrollViewer>
            <Button x:Name="AddFieldBtn" Content="{loc:Translate CredEdit.BtnAddField}" Tag="{loc:Translate Keys.CtrlShiftN}"
                    HorizontalAlignment="Left" Margin="0,4,0,0" />

            <TextBlock Text="{loc:Translate CredEdit.FldNote}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                     VerticalScrollBarVisibility="Auto" />

            <!-- Error de validación: dice QUÉ falta y el foco salta al campo (nunca un Guardar mudo). -->
            <TextBlock x:Name="ErrorText" Foreground="#E06C75" FontSize="12" Margin="0,10,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OkBtn" Content="{loc:Translate CredEdit.BtnSave}" Tag="{loc:Translate Keys.CtrlEnter}"
                        MinWidth="110" Margin="0,0,6,0" />
                <Button x:Name="CancelBtn" Content="{loc:Translate Prompt.Cancel}" Tag="{loc:Translate Keys.Escape}"
                        MinWidth="100" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
