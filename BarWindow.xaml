<Window x:Class="AmpzDesktopBooster.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="Ampz Booster Bar"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Borde + fondo de la barra -->
    <Border Background="{StaticResource BarBackground}"
            BorderBrush="#2A4FC3F7"
            BorderThickness="0,1,0,0">
        <Border.Effect>
            <DropShadowEffect Color="#4FC3F7" Direction="270"
                              ShadowDepth="2" BlurRadius="10" Opacity="0.12" />
        </Border.Effect>
        <Grid Margin="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />   <!-- Bloque izquierdo: hora/fecha -->
                <ColumnDefinition Width="*" />      <!-- Espaciador -->
                <ColumnDefinition Width="Auto" />   <!-- Bloque derecho: sistema -->
            </Grid.ColumnDefinitions>

            <!-- ===== Izquierda: Fecha (día completo, ej. "Viernes 30 de mayo") ===== -->
            <StackPanel x:Name="DateWidget" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="DateText" Style="{StaticResource WidgetLabel}" Margin="0,1,0,0" />
            </StackPanel>

            <!-- ===== Derecha: widgets de sistema (cada uno con su separador) ===== -->
            <StackPanel x:Name="RightPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- CPU -->
                <StackPanel x:Name="CpuWidget" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle x:Name="CpuSeparator" Width="1" Height="16" Fill="{StaticResource Separator}" Margin="14,0" />
                    <TextBlock Text="CPU" Style="{StaticResource WidgetLabel}" Margin="0,0,5,0" Foreground="{StaticResource Accent}" />
                    <TextBlock x:Name="CpuText" Style="{StaticResource WidgetValue}" Width="42" TextAlignment="Right" />
                </StackPanel>

                <!-- IPs: local (LAN) y pública (WAN), en ese orden y SIN rótulos — el formato de la
                     IP ya las distingue de un vistazo y los labels sólo comían ancho. Cuál es cuál
                     lo aclara el tooltip de cada una, que es donde corresponde: ayuda si dudás, no
                     ocupa lugar si no.
                     Cada valor es CLICKABLE y copia al portapapeles — que es para lo que uno mira una
                     IP (pegarla en un ssh, en el celu, en un ticket).
                     Ancho AUTOMÁTICO (sin Width fijo) a propósito: un ancho fijo tendría que medir
                     "255.255.255.255" (15 chars) y una IP real casi nunca llega a eso → dejaba un
                     hueco muerto detrás de cada valor, y son DOS. El costo es que el widget cambia de
                     tamaño cuando una IP cambia de largo; se acepta porque eso pasa muy de vez en
                     cuando (VPN, cambio de red), no cada segundo como las métricas.
                     "···" mientras todavía no resolvió (la pública es una consulta de red asíncrona:
                     hay un instante sin dato al arrancar). -->
                <StackPanel x:Name="IpWidget" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle x:Name="IpSeparator" Width="1" Height="16" Fill="{StaticResource Separator}" Margin="14,0" />
                    <TextBlock x:Name="IpLocalText" Style="{StaticResource WidgetValue}"
                               Cursor="Hand" Background="Transparent"
                               ToolTip="{loc:Translate Bar.IpLocalTooltip}" />
                    <Rectangle Width="1" Height="11" Fill="{StaticResource Separator}" Opacity="0.5"
                               Margin="7,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="IpPublicText" Style="{StaticResource WidgetValue}"
                               Cursor="Hand" Background="Transparent"
                               ToolTip="{loc:Translate Bar.IpPublicTooltip}" />
                </StackPanel>

                <!-- Uso de IA (provider activo): 3 mini-islas — sesión 5h, semanal todos, semanal por-modelo (la letra la setea el code-behind: hoy F de Fable, ayer S de Sonnet) —
                     separadas por un divisor delicado. % exacto + reset en el tooltip de cada isla.
                     El relleno lo setea el code-behind; se pone naranja al pasar 80%.
                     El separador izquierdo lo gestiona FixUpSeparators (se oculta si es el 1er widget visible). -->
                <StackPanel x:Name="UsageWidget" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle x:Name="UsageSeparator" Width="1" Height="16" Fill="{StaticResource Separator}" Margin="14,0" />
                    <Image Source="/Providers/anthropic.png" Width="20" Height="20" Margin="0,0,8,0"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Badge del plan. El texto lo setea el code-behind (snap.AccountLabel, ej. "Max 5x");
                         se oculta si no hay plan. El coral es el de la marca Claude (#D97757), para que
                         dialogue con el logo. El nombre va implícito en el logo, no hace falta texto. -->
                    <Border x:Name="PlanBadge" CornerRadius="4" Background="#26D97757" Padding="5,1,5,2"
                            VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed">
                        <TextBlock x:Name="PlanText" FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="#E89B7E" />
                    </Border>

                    <!-- Las 3 islas + sus divisores, agrupadas: así un solo Visibility las maneja
                         juntas. En error no quedan separadores huérfanos colgando. -->
                    <StackPanel x:Name="GaugesPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Sesión (5h) -->
                        <StackPanel x:Name="Gauge5h" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="5h" Style="{StaticResource WidgetLabel}" Margin="0,0,4,2" />
                            <Border Width="28" Height="8" CornerRadius="4" Background="#1B2D36" VerticalAlignment="Center">
                                <Border x:Name="Fill5h" Width="0" CornerRadius="4" Background="{StaticResource Accent}" HorizontalAlignment="Left" />
                            </Border>
                            <TextBlock x:Name="Pct5h" Style="{StaticResource WidgetValue}" Margin="5,0,0,0" />
                        </StackPanel>

                        <Rectangle Width="1" Height="11" Fill="{StaticResource Separator}" Opacity="0.3" Margin="5,0" VerticalAlignment="Center" />
                        <StackPanel x:Name="Gauge7d" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="7d" Style="{StaticResource WidgetLabel}" Margin="0,0,4,2" />
                            <Border Width="28" Height="8" CornerRadius="4" Background="#1B2D36" VerticalAlignment="Center">
                                <Border x:Name="Fill7d" Width="0" CornerRadius="4" Background="{StaticResource Accent}" HorizontalAlignment="Left" />
                            </Border>
                            <TextBlock x:Name="Pct7d" Style="{StaticResource WidgetValue}" Margin="5,0,0,0" />
                        </StackPanel>

                        <Rectangle Width="1" Height="11" Fill="{StaticResource Separator}" Opacity="0.3" Margin="5,0" VerticalAlignment="Center" />
                        <StackPanel x:Name="GaugeScoped" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LblScoped" Text="·" Style="{StaticResource WidgetLabel}" Margin="0,0,4,2" />
                            <Border Width="28" Height="8" CornerRadius="4" Background="#1B2D36" VerticalAlignment="Center">
                                <Border x:Name="FillScoped" Width="0" CornerRadius="4" Background="{StaticResource Accent}" HorizontalAlignment="Left" />
                            </Border>
                            <TextBlock x:Name="PctScoped" Style="{StaticResource WidgetValue}" Margin="5,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Estado cuando todavía no hay datos (rate limit / sin sesión). Oculto por default. -->
                    <TextBlock x:Name="UsageStatus" Style="{StaticResource WidgetLabel}" Visibility="Collapsed" />
                </StackPanel>

                <!-- RAM (sin label: el "GB" ya deja claro qué es) -->
                <StackPanel x:Name="RamWidget" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle x:Name="RamSeparator" Width="1" Height="16" Fill="{StaticResource Separator}" Margin="14,0" />
                    <TextBlock x:Name="RamText" Style="{StaticResource WidgetValue}" />
                </StackPanel>

                <!-- Red -->
                <StackPanel x:Name="NetworkWidget" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle x:Name="NetworkSeparator" Width="1" Height="16" Fill="{StaticResource Separator}" Margin="14,0" />
                    <TextBlock Text="&#x2193;" Style="{StaticResource WidgetIcon}" Foreground="{StaticResource Accent}" />
                    <TextBlock x:Name="NetDownText" Style="{StaticResource WidgetValue}" Width="74" />
                    <TextBlock Text="&#x2191;" Style="{StaticResource WidgetIcon}" Foreground="{StaticResource AccentWarn}" Margin="6,0,5,0" />
                    <TextBlock x:Name="NetUpText" Style="{StaticResource WidgetValue}" Width="74" />
                </StackPanel>

                <!-- Batería -->
                <StackPanel x:Name="BatteryWidget" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle x:Name="BatterySeparator" Width="1" Height="16" Fill="{StaticResource Separator}" Margin="14,0" />
                    <TextBlock x:Name="BatteryIcon" Style="{StaticResource WidgetIcon}" Text="&#x1F50B;" />
                    <TextBlock x:Name="BatteryText" Style="{StaticResource WidgetValue}" />
                </StackPanel>

                <!-- Tarea activa del desk: OCULTO hasta pickear una con Win+NumLock. Menos jerarquía
                     que el widget de Desktop a propósito (es info secundaria): sin dot de color, fondo
                     más sutil (#08 vs #0C), ícono y texto tenues, título recortado con elipsis. Todo
                     el bloque es clickable (Cursor=Hand + Background transparente para hit-test) → abre
                     el TaskDetailWindow. El separador sólo se ve cuando el widget está visible. -->
                <StackPanel x:Name="TaskWidget" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="Collapsed" Cursor="Hand" Background="Transparent"
                            ToolTip="{loc:Translate Bar.TaskWidgetTooltip}">
                    <Rectangle x:Name="TaskSeparator" Width="1" Height="16" Fill="{StaticResource Separator}" Margin="14,0" />
                    <Border Background="#08FFFFFF" CornerRadius="8" Padding="7,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE73A;" Style="{StaticResource WidgetIcon}" FontSize="11"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,6,0" />
                            <TextBlock x:Name="TaskIdText" Style="{StaticResource WidgetLabel}"
                                       Foreground="{StaticResource Accent}" Margin="0,0,6,0" />
                            <TextBlock x:Name="TaskTitleText" Style="{StaticResource WidgetLabel}"
                                       Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Atención por desk: dots de color (uno por desk que RECLAMA tu atención). OCULTO
                     cuando no hay nada pendiente (como el TaskWidget) → cero ruido el 99% del tiempo.
                     Rojo = te necesita (pulsa), verde = tarea lista (fijo). El número adentro del dot
                     es el desk; el color, la urgencia. Click en un dot → saltás a ese desk (y al entrar
                     se limpia solo). El panel lo popula el code-behind (UpdateAttention). El separador
                     vive DENTRO del widget → desaparece con él cuando colapsa. -->
                <StackPanel x:Name="AttentionWidget" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Rectangle x:Name="AttentionSeparator" Width="1" Height="16" Fill="{StaticResource Separator}" Margin="14,0" />
                    <StackPanel x:Name="AttentionDotsPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Desktop actual: ancho FIJO para que la barra NO se desplace al cambiar de
                     desktop (invariante: si fuera Auto, los widgets de la izquierda bailarían en
                     cada salto). Adentro, dos modos sobre el mismo espacio (como el legacy):
                       · DUAL  → con proyecto: dot + nombre a la izquierda + proyecto/módulo a la derecha
                       · SOLO  → sin proyecto: dot + nombre CENTRADOS
                     Sólo uno está visible a la vez; el ancho total no cambia nunca.

                     480: con 288 no entraban proyecto Y módulo (descontando separador 29, padding 16,
                     dot 14 y nombre 70 quedaban ~159px para los dos) y 400 seguía apretando; 576 se
                     comía media barra. 480 deja ~351px para el par → ~166px a cada uno al 50/50. -->
                <Grid x:Name="DeskWidget" VerticalAlignment="Center" Width="480">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />  <!-- separador -->
                        <ColumnDefinition Width="*" />     <!-- contenido (uno de los dos modos) -->
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Column="0" Width="1" Height="16" Fill="{StaticResource Separator}" Margin="14,0" />

                    <!-- Modo DUAL: desk CON proyecto -->
                    <Border Grid.Column="1" Background="#0CFFFFFF" CornerRadius="10" Padding="8,2">
                    <Grid x:Name="DeskDualPanel" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />  <!-- dot -->
                            <ColumnDefinition Width="70" />    <!-- nombre (fijo) -->
                            <ColumnDefinition Width="*" />     <!-- proyecto (resto, con elipsis) -->
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" x:Name="DeskDotDual" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="DeskNameDual" Style="{StaticResource WidgetValue}" />
                        <!-- Proyecto + módulo. El módulo lleva su color propio y una barrita: en la
                             barra, que es lo que mirás de reojo todo el día, el color es la señal. -->
                        <!-- Grid y no StackPanel: en un StackPanel horizontal los hijos reciben ancho
                             INFINITO y el TextTrimming nunca dispara → un proyecto largo se comería
                             al módulo (justo lo que no puede pasar).
                             Los anchos NO son fijos acá: los setea UpdateDesk en el code-behind, porque
                             el reparto correcto depende de si hay módulo o no (ver el comentario allá).
                             Topes fijos era el bug anterior: 150 proyecto / 110 módulo daba 58/42, no
                             50/50, y el módulo se cortaba mientras al proyecto le sobraba. -->
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="DeskProjectCol" Width="*" />    <!-- proyecto -->
                                <ColumnDefinition Width="Auto" />                          <!-- barrita de color -->
                                <ColumnDefinition x:Name="DeskModuleCol" Width="0" />      <!-- módulo -->
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="DeskProjectText" Style="{StaticResource WidgetValue}"
                                       Foreground="#FFD700" TextTrimming="CharacterEllipsis" />
                            <!-- NEUTRAL a propósito, aunque el módulo tenga color: esta barrita está
                                 ENTRE dos datos, o sea que lee como SEPARADOR. Pintarla del color del
                                 módulo confundía de qué lado pertenece. El color identifica al módulo
                                 en su TEXTO; el separador sólo separa.
                                 Margen SIMÉTRICO (8 y 8): las dos columnas "*" ya reparten el sobrante
                                 en partes iguales, así que la columna del divisor cae centrada — pero
                                 si sus márgenes fueran desparejos la LÍNEA quedaría corrida adentro de
                                 su propia celda. Con 8/8 el divisor cae exactamente en el medio. -->
                            <Rectangle Grid.Column="1" x:Name="DeskModuleAccent" Width="1" Height="12"
                                       Fill="{StaticResource Separator}" Margin="8,0"
                                       VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock Grid.Column="2" x:Name="DeskModuleText" Style="{StaticResource WidgetValue}"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    </Border>

                    <!-- Modo SOLO: desk SIN proyecto (centrado) -->
                    <Border Grid.Column="1" Background="#0CFFFFFF" CornerRadius="10" Padding="8,2">
                    <StackPanel x:Name="DeskSoloPanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="DeskDotSolo" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="DeskNameSolo" Style="{StaticResource WidgetValue}" />
                    </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</Window>
