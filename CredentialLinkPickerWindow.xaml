<Window x:Class="AmpzDesktopBooster.CredentialLinkPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate CredPick.WindowTitle}"
        Width="640" Height="520"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <!-- Hijo del editor de credenciales (que es Topmost): por eso también Topmost, o quedaría debajo
         de su propio dueño. Mismo piso visual que el editor. -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center" />
                                <Border x:Name="Keycap" Margin="8,0,0,0" Padding="4,0,4,1"
                                        CornerRadius="3" VerticalAlignment="Center"
                                        Background="#1A1A1A" BorderBrush="#4A4A52" BorderThickness="1">
                                    <TextBlock x:Name="KeycapText" FontFamily="Consolas" FontSize="10"
                                               Foreground="#9A9A9A"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Keycap" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34505C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E6E6EA" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262626" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeaderText" Foreground="#F2F2F2" FontSize="14" FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <TextBox Grid.Row="1" x:Name="FilterBox" Background="#2A2A2A" Foreground="#F2F2F2"
                     CaretBrush="#F2F2F2" BorderBrush="#4FC3F7" Padding="6,4" FontSize="13" Margin="0,10,0,8" />

            <Border Grid.Row="2" Background="#161616" CornerRadius="4" Padding="2">
                <Grid>
                    <!-- Virtualizado (default del ListBox): el catálogo de credenciales puede crecer. -->
                    <ListBox x:Name="ResultList" Background="Transparent" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#E6E6EA"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#8A8A92"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Vacío: dice si no hay NADA que vincular o si es la búsqueda (nunca en blanco). -->
                    <TextBlock x:Name="EmptyText" Visibility="Collapsed" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480"
                               TextAlignment="Center" TextWrapping="Wrap" Foreground="#8A8A92" FontSize="12" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" Foreground="#6E6E78" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="{loc:Translate CredPick.Hint}" />

            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Por qué Vincular no hizo nada (nada elegido): a la vista, nunca un botón mudo. -->
                <TextBlock x:Name="StatusText" Foreground="#E06C75" FontSize="12" VerticalAlignment="Center"
                           TextWrapping="Wrap" Visibility="Collapsed" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="PickBtn" Content="{loc:Translate CredPick.BtnPick}" Tag="{loc:Translate Keys.Enter}"
                            MinWidth="110" Margin="0,0,6,0" />
                    <Button x:Name="CancelBtn" Content="{loc:Translate Prompt.Cancel}" Tag="{loc:Translate Keys.Escape}"
                            MinWidth="100" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
