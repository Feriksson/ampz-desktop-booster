<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Barra de scroll OSCURA y fina. La de WPF por defecto es clara y ancha (17px): sobre los
         paneles oscuros de la app es una franja blanca que se lleva la mirada.

         Es un diccionario APARTE y no un estilo dentro de cada ventana porque una barra de scroll es
         un contrato (pista, pulgar, arrastre, click en la pista para paginar, vertical y horizontal),
         no markup para copiar: dos copias divergen en la primera corrección. Quien la quiera hace
         merge de este archivo en los Resources del tramo que le interese; el estilo es IMPLÍCITO, así
         que toma todas las barras de ahí para abajo (las de un ListBox, un ScrollViewer, el popup de
         un ComboBox) sin tocar nada más.

         Sin botones de flecha a propósito: en una barra de 10px no entran y nadie los usa (rueda,
         arrastre y teclado cubren todo).

         El largo MÍNIMO del pulgar: el Track no mira el MinHeight del Thumb, lo calcula como la mitad
         del alto de un botón de flecha del sistema (≈8px). Con miles de filas eso deja un punto
         imposible de ver y de agarrar. Por eso cada Track pisa esa medida del sistema en sus propios
         recursos (56 → mínimo de 28px): es el único lugar de donde la lee. -->

    <!-- El pulgar en reposo da ~3,5:1 contra los paneles (#161616 / #1E1E1E): se tiene que VER que
         hay más contenido, sin llamar la atención. -->
    <SolidColorBrush x:Key="DarkScrollThumbBrush" Color="#6E6E6E" />
    <SolidColorBrush x:Key="DarkScrollThumbHoverBrush" Color="#8C8C8C" />
    <SolidColorBrush x:Key="DarkScrollThumbDragBrush" Color="#AAAAAA" />

    <!-- Los tramos de pista a cada lado del pulgar: invisibles, pero CLICKEABLES (paginan). -->
    <Style x:Key="DarkScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- El pulgar. El margen deja aire contra el borde del panel (nada pega contra la barra) y el
         Border de afuera, transparente, mantiene clickeable todo el ancho aunque lo pintado sea fino. -->
    <Style x:Key="DarkScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border x:Name="Bar" Margin="2" CornerRadius="3"
                                Background="{StaticResource DarkScrollThumbBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background"
                                    Value="{StaticResource DarkScrollThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background"
                                    Value="{StaticResource DarkScrollThumbDragBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Resources>
                                <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">56</sys:Double>
                            </Track.Resources>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource DarkScrollPageButton}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource DarkScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource DarkScrollPageButton}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.Resources>
                                        <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">56</sys:Double>
                                    </Track.Resources>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource DarkScrollPageButton}"
                                                      Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource DarkScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource DarkScrollPageButton}"
                                                      Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
