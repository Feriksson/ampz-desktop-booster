<Application x:Class="AmpzDesktopBooster.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AmpzDesktopBooster"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- Paleta: dark, sobria. Cambiá estos colores y cambia toda la barra. -->
        <SolidColorBrush x:Key="BarBackground" Color="#E6151515" />
        <SolidColorBrush x:Key="TextPrimary"   Color="#F2F2F2" />
        <SolidColorBrush x:Key="TextMuted"     Color="#9A9A9A" />
        <SolidColorBrush x:Key="Accent"        Color="#4FC3F7" />
        <SolidColorBrush x:Key="AccentWarn"    Color="#FFB74D" />
        <SolidColorBrush x:Key="Separator"     Color="#33FFFFFF" />

        <!-- Niveles de carga de las barras de uso: celeste (ok) → amarillo → ámbar → rojo. -->
        <SolidColorBrush x:Key="GaugeYellow"   Color="#FFD54F" />
        <SolidColorBrush x:Key="GaugeAmber"    Color="#FF9800" />
        <SolidColorBrush x:Key="GaugeRed"      Color="#EF5350" />

        <Style x:Key="WidgetLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="WidgetValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <Style x:Key="WidgetIcon" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        </Style>

    </Application.Resources>
</Application>
