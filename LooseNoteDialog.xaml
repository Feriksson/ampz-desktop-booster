<Window x:Class="AmpzDesktopBooster.LooseNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate Notes.DlgTitle}"
        Width="480" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- ComboBox oscuro: el template default pinta el área de selección con el blanco del
             sistema e IGNORA Background/Foreground → hay que retemplatearlo (mismo criterio que
             ConfigWindow). El borde celeste con foco de teclado es lo que hace usable el diálogo
             sin mouse: sin él no se ve en qué combo estás parado. -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#2A2A2A" CornerRadius="3" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border IsHitTestVisible="False" CornerRadius="3" BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path Grid.Column="1" Fill="#F2F2F2" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" Data="M 0 0 L 8 0 L 4 5 Z" />
                                </Grid>
                            </Border>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="#2A2A2A" BorderBrush="#444" BorderThickness="1" CornerRadius="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4FC3F7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3C3C3C" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D4A57" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock x:Name="TitleText" Foreground="#F2F2F2" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

            <TextBlock Text="{loc:Translate Notes.DlgNoteTitle}" Foreground="#9A9A9A" FontSize="11" Margin="0,0,0,4" />
            <TextBox x:Name="TitleBox" Background="#2A2A2A" Foreground="#F2F2F2"
                     BorderBrush="#444" Padding="6,4" FontSize="13" />

            <TextBlock Text="{loc:Translate Notes.DlgSpace}" Foreground="#9A9A9A" FontSize="11" Margin="0,10,0,4" />
            <ComboBox x:Name="SpaceCombo" />

            <TextBlock Text="{loc:Translate Notes.DlgContext}" Foreground="#9A9A9A" FontSize="11" Margin="0,10,0,4" />
            <ComboBox x:Name="ContextCombo" />

            <TextBlock Text="{loc:Translate Notes.DlgTagHint}" Foreground="#6E6E78" FontSize="10"
                       Margin="0,8,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OkBtn" Content="{loc:Translate Prompt.Ok}" MinWidth="90" Margin="0,0,6,0" Padding="10,4" IsDefault="True" />
                <Button x:Name="CancelBtn" Content="{loc:Translate Prompt.Cancel}" MinWidth="90" Padding="10,4" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
