<Window x:Class="AmpzDesktopBooster.ServicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate Services.WindowTitle}"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <!-- El TAMAÑO no se declara acá: lo pone SizeToWorkArea en el constructor (90% x 80% del área de
         trabajo), igual que Notas. El ancho fijo de 1020 que había antes dejaba el comando y el
         directorio cortados con puntos suspensivos justo en la parte que más importa: los
         parámetros. Por eso WindowStartupLocation es Manual — con CenterScreen, WPF pisaría el
         Left/Top que calcula el helper. -->

    <Window.Resources>
        <!-- Mismo estilado de filas oscuras que ProjectPathsWindow: el GridView crea ListViewItems
             que NO heredan el tema del ListView → hay que estilarlos o salen con el tema claro. -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6E6EA" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#262626" />
                            </MultiTrigger>
                            <!-- Separador de sección heredada: línea sutil arriba + aire. -->
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#383838" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,1,0,0" />
                                <Setter TargetName="Bd" Property="Margin" Value="0,7,0,2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Heredadas (espacio padre o global): texto ATENUADO cuando NO están seleccionadas.
                     Se pueden LANZAR igual que las propias — heredar un servicio es justamente poder
                     levantarlo desde el contexto. Lo que no se puede es EDITARLAS acá (ver la ventana). -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsInherited}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#8A8A92" />
                </MultiDataTrigger>
                <!-- Directorio inexistente: el repo se movió o el worktree se borró. Rojo, como en
                     Variables — es la señal de que ese servicio HOY no puede levantar. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsBroken}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#E06C75" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Foreground" Value="#6E6E78" />
                    <Setter Property="FontSize" Value="11" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34505C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A6070" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#262626" />
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="BorderBrush" Value="#333" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="HeaderText" Foreground="#F2F2F2"
                       FontSize="16" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" x:Name="SubHeaderText" Foreground="#9A9A9A"
                       FontSize="11" Margin="0,2,0,10" />

            <TextBox Grid.Row="2" x:Name="FilterBox" Background="#2A2A2A" Foreground="#F2F2F2"
                     BorderBrush="#444" Padding="6,4" FontSize="13" Margin="0,0,0,8" />

            <Border Grid.Row="3" Background="#161616" CornerRadius="4" Padding="2">
                <ListView x:Name="ServiceList" Background="Transparent" BorderThickness="0"
                          Foreground="#E6E6EA" FontSize="13">
                    <ListView.View>
                        <GridView>
                            <!-- Estado como FIGURA real, no emoji: "🟢/⚪" en un GridView se rendean
                                 MONOCROMOS con la fuente por defecto (verde y gris quedan iguales, un
                                 circulito hueco indistinguible). Un Ellipse con Fill atado a un bool
                                 por DataTrigger es inequívoco. Bug ya cazado con instrumentación. -->
                            <GridViewColumn Header="{loc:Translate Services.ColStatus}" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="11" Height="11" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <!-- Sin puerto declarado (es una TAREA) → sin punto:
                                                         no tiene estado que mostrar y fingirlo mentiría. -->
                                                    <Setter Property="Fill" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPort}" Value="True">
                                                            <Setter Property="Fill" Value="#4A4A52" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                            <Setter Property="Fill" Value="#3FB950" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Los anchos de Titulo/Comando/Directorio los REPARTE el code-behind
                                 (LayoutColumns) con lo que sobra del ancho real de la ventana. Un
                                 GridViewColumn con Width fijo NO crece: agrandar la ventana sola
                                 dejaba el hueco a la derecha y el comando cortado igual. GridView no
                                 tiene star-sizing, asi que el reparto es a mano. Los valores de aca
                                 son solo el arranque, antes del primer layout. -->
                            <GridViewColumn x:Name="TitleCol" Header="{loc:Translate Services.ColTitle}" Width="240"
                                            DisplayMemberBinding="{Binding Display}" />
                            <GridViewColumn x:Name="CommandCol" Header="{loc:Translate Services.ColCommand}" Width="230"
                                            DisplayMemberBinding="{Binding Command}" />
                            <GridViewColumn x:Name="WorkDirCol" Header="{loc:Translate Services.ColWorkDir}" Width="330"
                                            DisplayMemberBinding="{Binding WorkDir}" />
                            <GridViewColumn Header="{loc:Translate Services.ColPort}" Width="80"
                                            DisplayMemberBinding="{Binding PortText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <TextBlock Grid.Row="4" Foreground="#6E6E78" FontSize="10" Margin="0,8,0,0"
                       TextWrapping="Wrap" Text="{loc:Translate Services.Hints}" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="LaunchBtn"    Content="{loc:Translate Services.BtnLaunch}" MinWidth="90" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="VisitBtn"     Content="{loc:Translate Services.BtnVisit}" MinWidth="90" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="LaunchAllBtn" Content="{loc:Translate Services.BtnLaunchAll}" MinWidth="120" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="AddBtn"       Content="{loc:Translate Services.BtnAdd}" MinWidth="90" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="EditBtn"      Content="{loc:Translate Services.BtnEdit}" MinWidth="90" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="DeleteBtn"    Content="{loc:Translate Services.BtnDelete}" MinWidth="70" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="CopyLocalBtn" Content="{loc:Translate Services.BtnCopyLocal}" MinWidth="120" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="QrBtn"        Content="{loc:Translate Services.BtnQr}" MinWidth="60" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="CloseBtn"     Content="{loc:Translate Services.BtnClose}" MinWidth="70" HorizontalAlignment="Right" Padding="10,4" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
