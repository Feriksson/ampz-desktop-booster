<Window x:Class="AmpzDesktopBooster.DeskPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate DeskPicker.WindowTitle}"
        Width="480" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True">

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock Foreground="#F2F2F2" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                       Text="{loc:Translate DeskPicker.Header}" Margin="0,0,0,10" />

            <TextBox x:Name="FilterBox" FontFamily="Segoe UI" FontSize="13"
                     Background="#2A2A2A" Foreground="#F2F2F2" BorderBrush="#444"
                     Padding="6,4" Margin="0,0,0,8" />

            <ListBox x:Name="DeskList" Height="240"
                     FontFamily="Segoe UI" FontSize="13"
                     Background="#161616" Foreground="#E6E6EA" BorderBrush="#333"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <TextBlock x:Name="EmptyHint" Foreground="#6E6E78" FontFamily="Segoe UI" FontSize="11"
                       Text="{loc:Translate DeskPicker.EmptyHint}"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0" />

            <TextBlock Foreground="#6E6E78" FontFamily="Segoe UI" FontSize="10" Margin="0,8,0,0"
                       Text="{loc:Translate DeskPicker.Hints}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="ClearAllBtn" Content="{loc:Translate DeskPicker.BtnClearAll}" Width="110" Height="26" Margin="0,0,8,0" />
                <Button x:Name="CloseBtn"    Content="{loc:Translate DeskPicker.BtnClose}" Width="90" Height="26" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
