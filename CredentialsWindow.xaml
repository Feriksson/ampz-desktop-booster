<Window x:Class="AmpzDesktopBooster.CredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate Creds.WindowTitle}"
        Width="1380" Height="860"
        WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Topmost="False"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <!-- Mismo piso visual que ProjectPathsWindow (Variables): es la ventana hermana — mismo scope,
         misma herencia, mismo gesto de teclado — y tienen que leerse como la misma familia. -->
    <Window.Resources>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6E6EA" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <GridViewRowPresenter x:Name="Presenter" Content="{TemplateBinding Content}"
                                                      Columns="{TemplateBinding GridView.ColumnCollection}" />
                                <!-- Fila-divisor de "otros espacios": a ancho completo (ver ProjectPathsWindow). -->
                                <TextBlock x:Name="SepText" Text="{Binding Title}" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#262626" />
                            </MultiTrigger>
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#383838" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,1,0,0" />
                                <Setter TargetName="Bd" Property="Margin" Value="0,7,0,2" />
                                <Setter TargetName="Presenter" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SepText" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Heredadas / de otros espacios: atenuadas cuando no están seleccionadas, igual que en
                     Variables. Acá NO significa "sólo lectura" (una credencial se edita donde viva):
                     significa "no es de tu scope", que es lo que la columna Espacio dice con texto. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsForeign}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#8A8A92" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Foreground" Value="#6E6E78" />
                    <Setter Property="FontSize" Value="11" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Botones con KEYCAP (Tag): mismo patrón y mismo motivo que Variables — en una app que se
             maneja sin mouse, el botón dice con qué tecla se dispara. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center" />
                                <Border x:Name="Keycap" Margin="8,0,0,0" Padding="4,0,4,1"
                                        CornerRadius="3" VerticalAlignment="Center"
                                        Background="#1A1A1A" BorderBrush="#4A4A52" BorderThickness="1">
                                    <TextBlock x:Name="KeycapText" FontFamily="Consolas" FontSize="10"
                                               Foreground="#9A9A9A"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Keycap" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                                <Setter TargetName="KeycapText" Property="Foreground" Value="#E6E6EA" />
                                <Setter TargetName="Keycap" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34505C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                                <Setter TargetName="KeycapText" Property="Foreground" Value="#E6E6EA" />
                                <Setter TargetName="Keycap" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A6070" />
                            </Trigger>
                            <!-- Apagado se VE apagado (p. ej. «Ir a la cuenta» de una cuenta eliminada); el
                                 motivo va escrito al lado, no en un tooltip que WPF no muestra. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flash de copiado (mismo storyboard que Variables), un poco más largo: el aviso nombra
             el campo y la credencial, y tiene que dar tiempo a leerlo. -->
        <Storyboard x:Key="CopyToastAnim">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CopyToast"
                                           Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0"    Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.6"  Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:3.0"  Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#262626" />
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="BorderBrush" Value="#333" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <!-- Rótulos y valores del panel de detalle. -->
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A92" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6E6EA" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" x:Name="HeaderText" Foreground="#F2F2F2"
                       FontSize="16" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="SubHeaderText" Foreground="#9A9A9A"
                       FontSize="11" Margin="0,2,0,10" />

            <TextBox Grid.Row="2" Grid.ColumnSpan="3" x:Name="FilterBox" Background="#2A2A2A" Foreground="#F2F2F2"
                     BorderBrush="#444" Padding="6,4" FontSize="13" Margin="0,0,0,8" />

            <Border Grid.Row="3" Grid.Column="0" Background="#161616" CornerRadius="4" Padding="2">
                <Grid>
                    <ListView x:Name="CredList" Background="Transparent" BorderThickness="0"
                              Foreground="#E6E6EA" FontSize="13">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{loc:Translate Paths.ColSpace}" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Project}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Project}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- Título + badge del proveedor (cuentas de identidad) + "vía X" (con qué
                                     cuenta se entra). DockPanel: badge y "vía" piden su ancho y el título
                                     es lo que se recorta, nunca al revés. -->
                                <GridViewColumn Header="{loc:Translate Creds.ColTitle}" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Margin="6,0,0,0" Padding="5,0,5,1"
                                                        CornerRadius="3" Background="#1F3A2A" BorderBrush="#3F7A55"
                                                        BorderThickness="1" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasBadge}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#A8E0BC" />
                                                </Border>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Via}" FontSize="11"
                                                           Foreground="#8A8A92" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           MaxWidth="150" TextTrimming="CharacterEllipsis" ToolTip="{Binding Via}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasVia}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Title}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{loc:Translate Creds.ColUser}" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding User}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding User}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- La contraseña de la LISTA es siempre una máscara de largo FIJO: no se
                                     revela nunca acá (el revelado es del panel de detalle, para UNA fila), y
                                     un largo fijo no le dice a quien mira por encima del hombro cuántos
                                     caracteres tiene. -->
                                <GridViewColumn Header="{loc:Translate Creds.ColPassword}" Width="100"
                                                DisplayMemberBinding="{Binding PasswordMask}" />
                                <GridViewColumn Header="{loc:Translate Creds.ColUrl}" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Host}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Url}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{loc:Translate Paths.ColContext}" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Module}" Foreground="{Binding ModuleBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Module}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Estado vacío: dice POR QUÉ no hay filas (scope sin credenciales vs búsqueda sin
                         coincidencias) y cómo seguir. Una lista en blanco se lee como "se rompió". -->
                    <TextBlock x:Name="EmptyText" Visibility="Collapsed" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="#8A8A92" FontSize="13" />
                </Grid>
            </Border>

            <!-- Toast de copiado: sobre la lista, sin ocupar layout (ver ProjectPathsWindow). -->
            <Border Grid.Row="3" Grid.Column="0" x:Name="CopyToast" Opacity="0" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                    Background="#F22D4A57" BorderBrush="#4FC3F7" BorderThickness="1"
                    CornerRadius="4" Padding="12,6" MaxWidth="820">
                <TextBlock x:Name="CopyToastText" Foreground="#FFFFFF" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- Detalle de la credencial seleccionada. Es el ÚNICO lugar donde un secreto se puede ver
                 en claro, y sólo después de pedirlo (Ctrl+R / Mostrar) para ESTA fila. -->
            <Border Grid.Row="3" Grid.Column="2" Background="#161616" CornerRadius="4" Padding="14,6,14,12">
                <Grid>
                    <TextBlock x:Name="NoSelectionText" Text="{loc:Translate Creds.NoSelection}"
                               Foreground="#6E6E78" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock x:Name="DetailTitle" Foreground="#F2F2F2" FontSize="15"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock x:Name="DetailScope" Foreground="#9A9A9A" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                            <Border x:Name="DetailProviderBorder" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Padding="6,1,6,2" CornerRadius="3" Background="#1F3A2A"
                                    BorderBrush="#3F7A55" BorderThickness="1" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Translate Creds.DetailProvider}" FontSize="10" Foreground="#7FBF97" />
                                    <TextBlock x:Name="DetailProvider" FontSize="10" Foreground="#A8E0BC" Margin="4,0,0,0"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{loc:Translate Creds.DetailUser}" Style="{StaticResource DetailLabel}" />
                            <TextBlock x:Name="DetailUser" Style="{StaticResource DetailValue}" />

                            <TextBlock Text="{loc:Translate Creds.DetailPassword}" Style="{StaticResource DetailLabel}" />
                            <TextBlock x:Name="DetailPassword" Style="{StaticResource DetailValue}"
                                       FontFamily="Consolas" />
                            <TextBlock x:Name="RevealedText" Text="{loc:Translate Creds.Revealed}"
                                       Foreground="#E5C07B" FontSize="10" Margin="0,2,0,0" Visibility="Collapsed" />

                            <TextBlock Text="{loc:Translate Creds.DetailUrl}" Style="{StaticResource DetailLabel}" />
                            <TextBlock x:Name="DetailUrl" Style="{StaticResource DetailValue}" />

                            <!-- Vínculos OAuth: con qué cuentas entra ésta, y quiénes entran con ésta. Las
                                 filas (con su «Ir a la cuenta») se arman en código. -->
                            <StackPanel x:Name="SignInSection" Visibility="Collapsed">
                                <TextBlock Text="{loc:Translate Creds.DetailSignInWith}" Style="{StaticResource DetailLabel}" />
                                <StackPanel x:Name="SignInPanel" />
                            </StackPanel>
                            <StackPanel x:Name="UsedBySection" Visibility="Collapsed">
                                <TextBlock Text="{loc:Translate Creds.DetailUsedBy}" Style="{StaticResource DetailLabel}" />
                                <StackPanel x:Name="UsedByPanel" />
                            </StackPanel>

                            <StackPanel x:Name="FieldsSection">
                                <TextBlock Text="{loc:Translate Creds.DetailFields}" Style="{StaticResource DetailLabel}" />
                                <StackPanel x:Name="FieldsPanel" />
                            </StackPanel>

                            <StackPanel x:Name="NoteSection">
                                <TextBlock Text="{loc:Translate Creds.DetailNote}" Style="{StaticResource DetailLabel}" />
                                <TextBlock x:Name="DetailNote" Style="{StaticResource DetailValue}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Foreground="#6E6E78" FontSize="10" Margin="0,8,0,0"
                       TextWrapping="Wrap" Text="{loc:Translate Creds.Hints}" />

            <WrapPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="CopyPasswordBtn" Content="{loc:Translate Creds.BtnCopyPassword}" Tag="{loc:Translate Keys.Enter}" Margin="0,0,6,6" Padding="10,4" />
                <Button x:Name="CopyUserBtn"     Content="{loc:Translate Creds.BtnCopyUser}" Tag="{loc:Translate Keys.CtrlU}" Margin="0,0,6,6" Padding="10,4" />
                <Button x:Name="CopyUrlBtn"      Content="{loc:Translate Creds.BtnCopyUrl}" Tag="{loc:Translate Keys.CtrlL}" Margin="0,0,6,6" Padding="10,4" />
                <Button x:Name="OpenUrlBtn"      Content="{loc:Translate Creds.BtnOpenUrl}" Tag="{loc:Translate Keys.CtrlO}" Margin="0,0,6,6" Padding="10,4" />
                <Button x:Name="RevealBtn"       Content="{loc:Translate Creds.BtnReveal}" Tag="{loc:Translate Keys.CtrlR}" MinWidth="90" Margin="0,0,6,6" Padding="10,4" />
                <Button x:Name="AddBtn"          Content="{loc:Translate Creds.BtnAdd}" Tag="{loc:Translate Keys.CtrlN}" Margin="0,0,6,6" Padding="10,4" />
                <Button x:Name="EditBtn"         Content="{loc:Translate Creds.BtnEdit}" Tag="{loc:Translate Keys.F2}" Margin="0,0,6,6" Padding="10,4" />
                <Button x:Name="DeleteBtn"       Content="{loc:Translate Creds.BtnDelete}" Tag="{loc:Translate Keys.Delete}" Margin="0,0,6,6" Padding="10,4" />
                <Button x:Name="AllProjectsBtn"  Content="{loc:Translate Paths.BtnAllProjectsOff}" Tag="{loc:Translate Keys.CtrlP}" MinWidth="160" Margin="0,0,6,6" Padding="10,4" />
                <!-- IsCancel: Esc cierra aunque el foco esté en un botón (ver ProjectPathsWindow). -->
                <Button x:Name="MinimizeBtn"     Content="{loc:Translate Notes.BtnMinimize}" Margin="0,0,6,6" Padding="10,4" />
                <Button x:Name="CloseBtn"        Content="{loc:Translate Creds.BtnClose}" Tag="{loc:Translate Keys.Escape}" Margin="0,0,6,6" Padding="10,4" IsCancel="True" />
            </WrapPanel>
        </Grid>
    </Border>
</Window>
