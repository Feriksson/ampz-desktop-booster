<Window x:Class="AmpzDesktopBooster.ProjectPathsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate Paths.WindowTitle}"
        Width="980" Height="700"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Filas: el GridView crea ListViewItems que NO heredan el Foreground/Background del
             ListView → hay que estilarlos acá, si no salen con el tema claro del sistema
             (fondo blanco, texto blanco = ilegible). -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6E6EA" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#262626" />
                            </MultiTrigger>
                            <!-- Separador "Globales": línea sutil arriba + aire, para que lea como divisor. -->
                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#383838" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,1,0,0" />
                                <Setter TargetName="Bd" Property="Margin" Value="0,7,0,2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Globales: texto ATENUADO cuando NO están seleccionadas (al seleccionarlas, el
                     trigger IsSelected del template les da blanco = feedback normal de selección).
                     Style.Triggers gana sobre Template.Triggers, por eso gateamos en IsSelected=False. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGlobal}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#8A8A92" />
                </MultiDataTrigger>
                <!-- Separador: rótulo de sección, NO seleccionable ni navegable (IsEnabled=False
                     hace que el teclado lo saltee y el mouse no lo seleccione). -->
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Foreground" Value="#6E6E78" />
                    <Setter Property="FontSize" Value="11" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Botones del footer. SIN style propio, WPF usa el default (gris claro) y el foco se
             dibuja como un puntito punteado negro casi invisible sobre fondo oscuro → no se ve
             cuál tiene el foco. Replicamos el patrón de AbrirConWindow: IsKeyboardFocused cambia
             borde a celeste + fondo, y FocusVisualStyle vacío mata el rectángulo punteado. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34505C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A6070" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Headers del GridView: también vienen claros por default -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#262626" />
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="BorderBrush" Value="#333" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="HeaderText" Foreground="#F2F2F2"
                       FontSize="16" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" x:Name="SubHeaderText" Foreground="#9A9A9A"
                       FontSize="11" Margin="0,2,0,10" />

            <TextBox Grid.Row="2" x:Name="FilterBox" Background="#2A2A2A" Foreground="#F2F2F2"
                     BorderBrush="#444" Padding="6,4" FontSize="13" Margin="0,0,0,8" />

            <Border Grid.Row="3" Background="#161616" CornerRadius="4" Padding="2">
                <ListView x:Name="PathList" Background="Transparent" BorderThickness="0"
                          Foreground="#E6E6EA" FontSize="13">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{loc:Translate Paths.ColTitle}" Width="250"
                                            DisplayMemberBinding="{Binding Display}" />
                            <GridViewColumn Header="{loc:Translate Paths.ColPath}" Width="660"
                                            DisplayMemberBinding="{Binding Path}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <TextBlock Grid.Row="4" Foreground="#6E6E78" FontSize="10" Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Text="{loc:Translate Paths.Hints}" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="AddBtn"        Content="{loc:Translate Paths.BtnAdd}" MinWidth="100" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="EditBtn"       Content="{loc:Translate Paths.BtnRename}" MinWidth="100" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="DefaultBtn"    Content="{loc:Translate Paths.BtnDefault}" MinWidth="140" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="DeleteBtn"     Content="{loc:Translate Paths.BtnDelete}" MinWidth="80" Margin="0,0,6,0" Padding="10,4" />
                <!-- IsCancel=True: Esc dispara el Click de este botón sin importar qué control
                     tenga el foco. Sin esto, al tabular a un botón el foco se va del FilterBox/
                     PathList y los PreviewKeyDown de Esc no se ejecutan → Esc dejaba de cerrar. -->
                <Button x:Name="CloseBtn"      Content="{loc:Translate Paths.BtnClose}" MinWidth="80" HorizontalAlignment="Right" Padding="10,4" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
