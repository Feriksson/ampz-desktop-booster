<Window x:Class="AmpzDesktopBooster.ProjectPathsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Variables"
        Width="720" Height="520"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Filas: el GridView crea ListViewItems que NO heredan el Foreground/Background del
             ListView → hay que estilarlos acá, si no salen con el tema claro del sistema
             (fondo blanco, texto blanco = ilegible). -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6E6EA" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#262626" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Headers del GridView: también vienen claros por default -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#262626" />
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="BorderBrush" Value="#333" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="HeaderText" Foreground="#F2F2F2"
                       FontSize="16" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" x:Name="SubHeaderText" Foreground="#9A9A9A"
                       FontSize="11" Margin="0,2,0,10" />

            <TextBox Grid.Row="2" x:Name="FilterBox" Background="#2A2A2A" Foreground="#F2F2F2"
                     BorderBrush="#444" Padding="6,4" FontSize="13" Margin="0,0,0,8" />

            <Border Grid.Row="3" Background="#161616" CornerRadius="4" Padding="2">
                <ListView x:Name="PathList" Background="Transparent" BorderThickness="0"
                          Foreground="#E6E6EA" FontSize="13">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Título" Width="220"
                                            DisplayMemberBinding="{Binding Display}" />
                            <GridViewColumn Header="Path / URL" Width="440"
                                            DisplayMemberBinding="{Binding Path}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <TextBlock Grid.Row="4" Foreground="#6E6E78" FontSize="10" Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Text="Enter / doble clic: abrir · Shift+Enter: abrir en Claude CLI · Ctrl+C: copiar path · F2: renombrar · F3 o ⭐: predeterminado · Supr: borrar · Esc: cerrar" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="AddBtn"        Content="＋ Agregar" MinWidth="100" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="EditBtn"       Content="✎ Renombrar" MinWidth="100" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="DefaultBtn"    Content="⭐ Predeterminado" MinWidth="140" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="DeleteBtn"     Content="Borrar" MinWidth="80" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="CloseBtn"      Content="Cerrar" MinWidth="80" HorizontalAlignment="Right" Padding="10,4" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
