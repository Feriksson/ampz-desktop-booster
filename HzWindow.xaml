<Window x:Class="AmpzDesktopBooster.HzWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frecuencia de pantalla"
        Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock x:Name="CurrentText" Foreground="#9A9A9A" FontSize="12" Margin="0,0,0,10" />
            <StackPanel x:Name="RatesPanel" />
            <TextBlock Foreground="#6E6E78" FontSize="10" Margin="0,4,0,0"
                       Text="Win+F12: ciclar · soltar Win: aplicar · clic: aplicar directo · Esc: cancelar" />
        </StackPanel>
    </Border>
</Window>
