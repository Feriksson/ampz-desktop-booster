<Window x:Class="AmpzDesktopBooster.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ampz Booster Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Popup central al cambiar de desktop: nombre del desk, dots de navegación, y proyecto.
         Orden: título arriba, círculos al medio, proyecto en la última línea. -->
    <Border Background="#F21A1A1A" CornerRadius="12" Padding="60,34">
        <StackPanel HorizontalAlignment="Center">

            <TextBlock x:Name="TitleText"
                       FontFamily="Segoe UI" FontSize="32" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" />

            <!-- Los dots se generan en código según la cantidad real de desktops -->
            <StackPanel x:Name="DotsPanel" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,26,0,0" />

            <!-- Proyecto: última línea, después de los círculos -->
            <TextBlock x:Name="ProjectText"
                       FontFamily="Segoe UI" FontSize="20" Foreground="#FFD700"
                       HorizontalAlignment="Center" Margin="0,26,0,0" />

        </StackPanel>
    </Border>
</Window>
