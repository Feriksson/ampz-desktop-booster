<Window x:Class="AmpzDesktopBooster.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate Overlay.Title}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Popup central al cambiar de desktop: nombre del desk, dots de navegación, y proyecto.
         Orden: título arriba, círculos al medio, proyecto en la última línea. -->
    <Border Background="#F21A1A1A" CornerRadius="12" Padding="60,34">
        <StackPanel HorizontalAlignment="Center">

            <TextBlock x:Name="TitleText"
                       FontFamily="Segoe UI" FontSize="32" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" />

            <!-- Los dots se generan en código según la cantidad real de desktops -->
            <StackPanel x:Name="DotsPanel" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,26,0,0" />

            <!-- Proyecto: última línea, después de los círculos -->
            <TextBlock x:Name="ProjectText"
                       FontFamily="Segoe UI" FontSize="20" Foreground="#FFD700"
                       HorizontalAlignment="Center" Margin="0,26,0,0" />

            <!-- Módulo (sub-scope del proyecto). Va DEBAJO del proyecto y con su color propio,
                 en una píldora con barra lateral: el punto de esta feature es distinguir el módulo
                 de reflejo, sin leer — el color hace ese trabajo, el texto sólo confirma. -->
            <Border x:Name="ModuleChip" HorizontalAlignment="Center" Margin="0,12,0,0"
                    CornerRadius="6" Padding="12,5" Background="#14FFFFFF">
                <StackPanel Orientation="Horizontal">
                    <Rectangle x:Name="ModuleAccent" Width="4" RadiusX="2" RadiusY="2"
                               Margin="0,0,10,0" />
                    <TextBlock x:Name="ModuleText" FontFamily="Segoe UI" FontSize="18"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</Window>
