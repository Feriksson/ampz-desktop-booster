<Window x:Class="AmpzDesktopBooster.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate Overlay.Title}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Popup central al cambiar de desktop. Orden: título (el ESPACIO en un desk de espacio, el nombre
         en un fijo), chip del contexto justo debajo, y los dots de navegación al final. -->
    <!-- ANCHO FIJO (pedido explícito): antes la card se medía por el texto y cambiaba de tamaño en
         cada salto — un popup que "respira" distinto según el nombre del desk se lee como otro
         popup. Ahora siempre es la misma caja y lo que no entra se corta con "…". El alto sigue
         libre (con o sin chip de contexto); la ventana sigue en SizeToContent, pero con este Width
         el contenido ya no puede moverle el ancho.
         TIPOGRAFÍA: Cascadia Mono (viene con Windows 11 / Windows Terminal; Consolas de respaldo).
         WPF no tiene letter-spacing, así que "más espaciada" se resuelve eligiendo una familia de
         paso fijo: cada letra tiene su celda y el nombre se lee de un golpe. -->
    <Border x:Name="Card" Background="#F21A1A1A" CornerRadius="16" Padding="56,46" Width="760">
        <StackPanel HorizontalAlignment="Stretch">

            <TextBlock x:Name="TitleText"
                       FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="38" FontWeight="SemiBold"
                       Foreground="White" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                       HorizontalAlignment="Center" />

            <!-- Contexto (sub-scope del espacio). Va DEBAJO del espacio (el título), en su propia línea y con su
                 color propio: el punto de esta feature es distinguir el contexto de reflejo, sin leer —
                 el color hace ese trabajo, el texto sólo confirma.
                 SIN barrita de acento a la izquierda: acá el contexto está solo en su línea, así que
                 una barra vertical al costado no lee como acento sino como un "|" pegado al nombre.
                 En la barra y el DeskPicker sí la lleva, porque ahí va INLINE al lado del espacio y
                 hace de separador. Mismo dato, distinta necesidad según el contexto. -->
            <Border x:Name="ModuleChip" HorizontalAlignment="Center" Margin="0,30,0,0"
                    CornerRadius="6" Padding="14,5" Background="#14FFFFFF">
                <TextBlock x:Name="ModuleText" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="18"
                           FontWeight="Normal" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" />
            </Border>

            <!-- Los dots se generan en código según la cantidad real de desktops. Van AL FINAL: en un
                 desk de espacio el título es el espacio y el chip de abajo el contexto, y el par tiene
                 que leerse JUNTO — con los dots en el medio (como cuando el título era "DESK +N") el
                 usuario lo vio partido y lo rechazó. En un fijo no hay chip: título y dots, igual que antes. -->
            <StackPanel x:Name="DotsPanel" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,34,0,0" />

        </StackPanel>
    </Border>
</Window>
