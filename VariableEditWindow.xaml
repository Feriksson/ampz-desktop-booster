<Window x:Class="AmpzDesktopBooster.VariableEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate Vars.DlgTitle}"
        Width="620" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34505C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Foreground="#F2F2F2" FontSize="14"
                       FontWeight="SemiBold" Margin="0,0,0,2" />
            <!-- El scope SIEMPRE a la vista: el mismo título de variable significa cosas distintas
                 según dónde viva, y este diálogo se abre desde una pestaña donde estás saltando de
                 scope en scope. Sin este renglón, guardás en el lugar equivocado sin enterarte. -->
            <TextBlock x:Name="ScopeText" Margin="0,0,0,12" />

            <TextBlock Text="{loc:Translate Vars.FldTitle}" />
            <TextBox x:Name="TitleBox" />

            <TextBlock Text="{loc:Translate Vars.FldPath}" />
            <TextBox x:Name="PathBox" Margin="0,0,0,4" />

            <TextBlock Text="{loc:Translate Vars.DlgHint}" TextWrapping="Wrap"
                       Foreground="#6E6E78" FontSize="10" Margin="0,0,0,4" />

            <!-- Diagnóstico en vivo del path: si apunta a algo que no existe en disco, se dice ACÁ y
                 no tres pantallas después cuando el atajo no abre nada. Las URLs nunca se marcan
                 rotas (verificarlas exigiría un request, ver ProjectPathsWindow.IsBrokenPath). -->
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="11"
                       Visibility="Collapsed" Margin="0,0,0,6" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="OkBtn" Content="{loc:Translate Prompt.Ok}" MinWidth="90"
                        Margin="0,0,6,0" Padding="10,4" IsDefault="True" />
                <Button x:Name="CancelBtn" Content="{loc:Translate Prompt.Cancel}" MinWidth="90"
                        Padding="10,4" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
