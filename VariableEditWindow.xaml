<Window x:Class="AmpzDesktopBooster.VariableEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate Vars.DlgTitle}"
        Width="620" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34505C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox oscuro: el template default pinta el área de selección con el blanco del
             sistema e IGNORA Background/Foreground → hay que retemplatearlo (mismo template que
             LooseNoteDialog). El borde celeste con foco de teclado es lo que lo hace usable sin
             mouse: sin él no se ve en qué combo estás parado. -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#2A2A2A" CornerRadius="3" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border IsHitTestVisible="False" CornerRadius="3" BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path Grid.Column="1" Fill="#F2F2F2" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" Data="M 0 0 L 8 0 L 4 5 Z" />
                                </Grid>
                            </Border>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="#2A2A2A" BorderBrush="#444" BorderThickness="1" CornerRadius="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4FC3F7" />
                </Trigger>
                <!-- Contexto con la Global elegida: apagado a la vista, no sólo inerte al click. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3C3C3C" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D4A57" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Foreground="#F2F2F2" FontSize="14"
                       FontWeight="SemiBold" Margin="0,0,0,2" />
            <!-- El scope SIEMPRE a la vista: el mismo título de variable significa cosas distintas
                 según dónde viva, y este diálogo se abre desde una pestaña donde estás saltando de
                 scope en scope. Sin este renglón, guardás en el lugar equivocado sin enterarte. En
                 un alta con picker se reescribe en vivo ("Se guarda en: …") a medida que elegís. -->
            <TextBlock x:Name="ScopeText" Margin="0,0,0,12" />

            <!-- Dónde se guarda: SÓLO en un alta y sólo si hay catálogo (ver ScopePicker). Arriba de
                 todo para ver el destino junto con lo que cargás; en una edición no aparece porque
                 cambiar de scope una entrada existente es MOVERLA, y eso vive en la config. -->
            <Grid x:Name="ScopePickerPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Translate Scope.FldSpace}" />
                    <ComboBox x:Name="SpaceCombo" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Translate Scope.FldContext}" />
                    <ComboBox x:Name="ContextCombo" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{loc:Translate Vars.FldTitle}" />
            <TextBox x:Name="TitleBox" />

            <TextBlock Text="{loc:Translate Vars.FldPath}" />
            <TextBox x:Name="PathBox" Margin="0,0,0,4" />

            <TextBlock Text="{loc:Translate Vars.DlgHint}" TextWrapping="Wrap"
                       Foreground="#6E6E78" FontSize="10" Margin="0,0,0,4" />

            <!-- Diagnóstico en vivo del path: si apunta a algo que no existe en disco, se dice ACÁ y
                 no tres pantallas después cuando el atajo no abre nada. Las URLs nunca se marcan
                 rotas (verificarlas exigiría un request, ver ProjectPathsWindow.IsBrokenPath). -->
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="11"
                       Visibility="Collapsed" Margin="0,0,0,6" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="OkBtn" Content="{loc:Translate Prompt.Ok}" MinWidth="90"
                        Margin="0,0,6,0" Padding="10,4" IsDefault="True" />
                <Button x:Name="CancelBtn" Content="{loc:Translate Prompt.Cancel}" MinWidth="90"
                        Padding="10,4" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
