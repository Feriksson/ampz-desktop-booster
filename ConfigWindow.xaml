<Window x:Class="AmpzDesktopBooster.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate Config.WindowTitle}"
        Width="1029" Height="840"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Fg"      Color="#F2F2F2" />
        <SolidColorBrush x:Key="FgMuted" Color="#9A9A9A" />
        <SolidColorBrush x:Key="Panel"   Color="#161616" />
        <SolidColorBrush x:Key="Accent"  Color="#4FC3F7" />
        <SolidColorBrush x:Key="Danger"  Color="#E5534B" />

        <!-- TextBlock global -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
        </Style>

        <!-- CheckBox global -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Button: dark rounded con hover/press/disabled -->
        <Style TargetType="Button">
            <Setter Property="Padding"          Value="10,5" />
            <Setter Property="Margin"           Value="0,0,6,0" />
            <Setter Property="MinWidth"         Value="80" />
            <Setter Property="Foreground"       Value="{StaticResource Fg}" />
            <Setter Property="Background"       Value="#2D2D2D" />
            <Setter Property="BorderBrush"      Value="#484848" />
            <Setter Property="BorderThickness"  Value="1" />
            <Setter Property="Cursor"           Value="Hand" />
            <Setter Property="FontSize"         Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"   Value="#3C3C3C" />
                                <Setter TargetName="bd" Property="BorderBrush"  Value="#606060" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222222" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem: hover + selección en acento -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Padding"    Value="8,5" />
            <Setter Property="Margin"     Value="2,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#282828" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A3A4A" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox: el template default tira el área de selección con SystemColors.WindowBrush
             (blanco) IGNORANDO el Foreground/Background que setees inline → letras blancas sobre
             fondo blanco. Sólo se arregla retempleteando. Mantenemos el header como ToggleButton
             entero para que click en cualquier punto abra el dropdown (no sólo en la flecha). -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground"      Value="{StaticResource Fg}" />
            <Setter Property="Background"      Value="#2A2A2A" />
            <Setter Property="BorderBrush"     Value="#444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="8,4" />
            <Setter Property="MinHeight"       Value="28" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="22" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter x:Name="header" Grid.Column="0"
                                                                  Margin="8,0,0,0" VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left" />
                                                <Path Grid.Column="1" Fill="{StaticResource Fg}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 8 0 L 4 5 Z" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#606060" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- El selected item se inyecta en el header del ToggleButton via Content -->
                            <ContentPresenter IsHitTestVisible="False" Margin="8,0,30,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="#2A2A2A" BorderBrush="#444" BorderThickness="1" CornerRadius="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem: el popup default de WPF tira items con fondo CLARO que matan la lectura
             sobre el tema oscuro. Mismo criterio que el ListBoxItem de arriba: hover gris, selección
             en acento, foreground claro siempre. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Padding"    Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3C3C3C" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A3A4A" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl: navegación VERTICAL a la izquierda (sidebar), no la tira horizontal de
             arriba. Se retemplatea entero en vez de usar TabStripPlacement="Left" porque el
             template default no deja pintarle fondo/borde propios a la tira: con 8 secciones el
             sidebar necesita leerse como una SUPERFICIE aparte del contenido, no como pestañas
             giradas. Ese fue justamente el problema de la barra horizontal — creció tanto que las
             pestañas se apretaban y dejaba de leerse dónde estabas parado.
             La tira va dentro de un ScrollViewer: si mañana entran más secciones que alto de
             pantalla, scrollea el sidebar SOLO (un scroller por eje, el contenido tiene el suyo). -->
        <Style TargetType="TabControl">
            <Setter Property="Background"       Value="#1E1E1E" />
            <Setter Property="BorderThickness"  Value="0" />
            <Setter Property="Padding"          Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#161616"
                                    BorderBrush="#2A2A2A" BorderThickness="0,0,1,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="0,0,2,0">
                                    <StackPanel IsItemsHost="True" Margin="6,10,6,10" />
                                </ScrollViewer>
                            </Border>

                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabItem: fila del sidebar — ícono + etiqueta, barra de acento a la IZQUIERDA.
             El acento se mudó de abajo (underline) al costado izquierdo porque en una lista
             vertical el borde inferior se lee como SEPARADOR entre filas, no como "estás acá".
             El ícono sale del Tag del TabItem para no meterle markup a cada Header (que sigue
             siendo la key de traducción, intacta) y va en una columna de ancho FIJO: así las
             etiquetas arrancan todas alineadas aunque los glifos midan distinto. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding"    Value="10,9" />
            <Setter Property="FontSize"   Value="12" />
            <Setter Property="Cursor"     Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                CornerRadius="0,4,4,0" Margin="0,1"
                                MinWidth="196"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ic" Grid.Column="0" FontSize="14"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter x:Name="cp" Grid.Column="1"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#232323" />
                                <Setter TargetName="cp" Property="TextBlock.Foreground"
                                        Value="{StaticResource Fg}" />
                            </Trigger>
                            <!-- Foco por TECLADO visible aparte del hover: navegar el sidebar con
                                 flechas no puede dejarte sin saber dónde está el cursor. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26333A" />
                                <Setter TargetName="cp" Property="TextBlock.Foreground"
                                        Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A3A4A" />
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{StaticResource Accent}" />
                                <Setter TargetName="cp" Property="TextBlock.Foreground"
                                        Value="{StaticResource Fg}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl x:Name="Tabs" Background="#1E1E1E" BorderThickness="0" UseLayoutRounding="False">

        <!-- ===== Pestaña ESCRITORIOS — VA PRIMERA A PROPÓSITO =====
             Es el cimiento del que cuelga todo lo demás: los espacios sólo existen en un desk de rol
             Espacio, las protecciones sólo en uno Fijo, y el atajo del numpad es la puerta de entrada
             a la app entera. Estaba cuarta y eso la volvía el último lugar donde uno mira cuando algo
             deja de responder — justo al revés de lo que hace falta.

             Cada fila edita una ENTRADA del catálogo, no un string: el nombre es sólo la etiqueta, y
             la tecla y el rol viven pegados a la entrada. Por eso ahora renombrar un escritorio no
             puede romperle el atajo (que era el bug que originó esta pantalla). Ver ManagedDesktop. -->
        <TabItem Tag="🖥️" Header="{loc:Translate Config.DesktopsTab}">
            <Grid Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold"
                           Text="{loc:Translate Config.ManagedDesktops}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Foreground="{StaticResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="{loc:Translate Config.ManagedDesktopsHint}" />

                <!-- Encabezado de columnas: sin esto, tres combos seguidos no dicen qué editan. -->
                <Grid Grid.Row="2" Grid.Column="0" Margin="10,0,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="2" Text="{loc:Translate Config.DeskColName}"  FontSize="10" Foreground="{StaticResource FgMuted}" />
                    <TextBlock Grid.Column="3" Text="{loc:Translate Config.DeskColKey}"   FontSize="10" Foreground="{StaticResource FgMuted}" Margin="6,0,0,0" />
                    <TextBlock Grid.Column="4" Text="{loc:Translate Config.DeskColRole}"  FontSize="10" Foreground="{StaticResource FgMuted}" Margin="6,0,0,0" />
                    <TextBlock Grid.Column="5" Text="{loc:Translate Config.DeskColState}" FontSize="10" Foreground="{StaticResource FgMuted}" Margin="6,0,0,0" />
                </Grid>

                <Border Grid.Row="3" Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="4" Padding="2">
                    <ListBox x:Name="DeskList" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource Fg}" FontSize="13"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <!-- Hereda el estilo global de ListBoxItem y le suma una sola cosa: al
                                 tocar CUALQUIER control de la fila (el nombre, un combo), la fila
                                 queda seleccionada. Sin esto podías estar tipeando en la fila 3 y
                                 tener seleccionada la 1 → "Subir" movía otra. -->
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="6,3" />
                                <EventSetter Event="PreviewGotKeyboardFocus" Handler="DeskRowFocused" />
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DeskRowClicked" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Position}" FontSize="11"
                                               Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" />

                                    <!-- Muestrario de color: click → paleta. El color se ve ACÁ y no en
                                         un diálogo aparte porque es la misma señal que vas a ver de
                                         reflejo en la barra y el overlay. -->
                                    <Button Grid.Column="1" Width="20" Height="20" Padding="0" MinWidth="0"
                                            Margin="0,0,8,0" Cursor="Hand"
                                            Background="{Binding Swatch}" BorderBrush="#555"
                                            ToolTip="{loc:Translate Config.DeskColorTip}"
                                            Tag="{Binding}" Click="PickDeskColor" />

                                    <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                             Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                             BorderBrush="#444" Padding="6,3" VerticalContentAlignment="Center" />

                                    <ComboBox Grid.Column="3" Margin="6,0,0,0"
                                              ItemsSource="{Binding KeyChoices}" SelectedItem="{Binding SelectedKey}" />

                                    <ComboBox Grid.Column="4" Margin="6,0,0,0"
                                              ItemsSource="{Binding RoleChoices}" SelectedItem="{Binding SelectedRole}" />

                                    <TextBlock Grid.Column="5" Margin="8,0,0,0" FontSize="11"
                                               VerticalAlignment="Center"
                                               Text="{Binding Status}" Foreground="{Binding StatusBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Mapa del numpad: la respuesta de un vistazo a "¿qué tecla me lleva a dónde?".
                     Es el control que faltaba — el atajo era invisible hasta que dejaba de andar. -->
                <Border Grid.Row="2" Grid.RowSpan="4" Grid.Column="1" Margin="14,0,0,0" Width="248"
                        Background="{StaticResource Panel}" CornerRadius="4" Padding="12"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Config.DeskShortcutMap}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Translate Config.DeskShortcutMapHint}" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{StaticResource FgMuted}" Margin="0,3,0,10" />
                        <UniformGrid x:Name="NumpadPreview" Rows="3" Columns="3" />
                        <TextBlock Text="{loc:Translate Config.DeskRoleLegend}" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{StaticResource FgMuted}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Reordenar / quitar -->
                <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="UpBtn"     Content="{loc:Translate Config.MoveUp}" />
                    <Button x:Name="DownBtn"   Content="{loc:Translate Config.MoveDown}" />
                    <Button x:Name="RemoveBtn" Content="{loc:Translate Config.Remove}" />
                </StackPanel>

                <!-- Alta nueva -->
                <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="NameBox" Width="320" Background="#2A2A2A"
                             Foreground="{StaticResource Fg}" BorderBrush="#444" Padding="6,4"
                             VerticalContentAlignment="Center" />
                    <Button x:Name="AddBtn" Content="{loc:Translate Config.Add}" Margin="6,0,0,0" />
                </StackPanel>

                <!-- Footer: autocreate + acciones -->
                <Grid Grid.Row="6" Grid.ColumnSpan="2" Margin="0,14,0,0">
                    <CheckBox x:Name="AutoCreateChk" Foreground="{StaticResource Fg}"
                              VerticalAlignment="Center"
                              Content="{loc:Translate Config.AutoCreateDesktops}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ApplyNowBtn" Content="{loc:Translate Config.CreateMissingNow}" MinWidth="150" />
                        <Button x:Name="SaveBtn" Content="{loc:Translate Config.Save}" MinWidth="100"
                                Background="{StaticResource Accent}" Foreground="#10222A" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ===== Pestaña ESPACIOS Y CONTEXTOS =====
             Lista PLANA con indentación en vez de un TreeView: el ListBox ya tiene el estilo oscuro
             de esta ventana (hover, selección en acento, foco) y lo comparten todas las demás
             pestañas. Un TreeView traería su propio template blanco y habría que reconstruirle el
             piso entero — una segunda implementación del mismo componente, que es justo lo que no
             hay que hacer. Con dos niveles fijos, la indentación alcanza y sobra. -->
        <TabItem Tag="🗂️" Header="{loc:Translate Config.ScopesTab}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                           Text="{loc:Translate Config.ScopesTitle}" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="{loc:Translate Config.ScopesHint}" />

                <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="4" Padding="2">
                    <Grid>
                        <ListBox x:Name="ScopeList" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Fg}" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        <!-- Estado vacío: nunca una lista en blanco sin explicar qué falta ni cómo salir. -->
                        <TextBlock x:Name="ScopeEmptyHint" Visibility="Collapsed"
                                   Foreground="{StaticResource FgMuted}" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="420"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Text="{loc:Translate Config.ScopesEmpty}" />
                    </Grid>
                </Border>

                <!-- Acciones sobre lo seleccionado. Se habilitan/deshabilitan según el tipo de fila:
                     un botón cuyo significado cambiaría según la selección sería ambiguo. -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="ScopeRenameBtn"  Content="{loc:Translate Config.ScopesRename}"  MinWidth="120" />
                    <Button x:Name="ScopeColorBtn"   Content="{loc:Translate Config.ScopesColor}"   MinWidth="140" />
                    <Button x:Name="ScopePromoteBtn" Content="{loc:Translate Config.ScopesPromote}" MinWidth="160" />
                    <!-- Duplicar un ESPACIO no necesita destino (nace como espacio nuevo), por eso vive
                         acá. El de CONTEXTO sí lo necesita y vive abajo, con el combo. -->
                    <Button x:Name="ScopeDuplicateBtn" Content="{loc:Translate Config.ScopesDuplicate}" MinWidth="150" />
                    <Button x:Name="ScopeDeleteBtn"  Content="{loc:Translate Config.ScopesDelete}"  MinWidth="90"
                            Foreground="{StaticResource Danger}" />
                </StackPanel>

                <!-- Reasignación: el destino se elige UNA vez y lo comparten Mover (contexto→otro
                     espacio) y Degradar (espacio→contexto de otro). Son la misma pregunta —"¿adónde
                     va esto?"— así que comparten el control en vez de duplicarlo. -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Translate Config.ScopesTargetLabel}" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMuted}" FontSize="12" Margin="0,0,8,0" />
                    <ComboBox x:Name="ScopeTargetCombo" Width="240" Margin="0,0,10,0" />
                    <Button x:Name="ScopeMoveBtn"   Content="{loc:Translate Config.ScopesMove}"   MinWidth="150" />
                    <Button x:Name="ScopeDemoteBtn" Content="{loc:Translate Config.ScopesDemote}" MinWidth="160" />
                    <!-- Duplicar un CONTEXTO aterriza EN un espacio, así que usa el mismo destino que
                         Mover. Eligiendo el espacio propio, la copia queda al lado del original. -->
                    <Button x:Name="ScopeDuplicateToBtn" Content="{loc:Translate Config.ScopesDuplicateTo}" MinWidth="170" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ===== Pestaña VARIABLES =====
             Hermana de la de Espacios: aquella reorganiza la JERARQUÍA, ésta el CONTENIDO. Dos
             paneles a propósito — el izquierdo es el mapa de scopes (y el blanco de los drops), el
             derecho el contenido del scope elegido. Ver las dos cosas a la vez es lo que hace que
             mover una variable sea un gesto y no una operación a ciegas: ves de dónde sale, ves
             adónde entra, y ves el contador del destino subir. -->
        <TabItem Tag="🔗" Header="{loc:Translate Config.VarsTab}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                           Text="{loc:Translate Config.VarsTitle}" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="{loc:Translate Config.VarsHint}" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Panel izquierdo: los scopes. AllowDrop porque CADA fila es un destino. -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{loc:Translate Config.VarsScopesHeader}"
                                   Foreground="{StaticResource FgMuted}" FontSize="11" Margin="2,0,0,5" />
                        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="4" Padding="2">
                            <ListBox x:Name="VarScopeList" Background="Transparent" BorderThickness="0"
                                     AllowDrop="True"
                                     Foreground="{StaticResource Fg}" FontSize="13"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Border>
                    </Grid>

                    <!-- Panel derecho: las variables del scope elegido. -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VarScopeHeader" Grid.Column="0" VerticalAlignment="Center"
                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{loc:Translate Config.VarsFilterLabel}"
                                       VerticalAlignment="Center" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,6,0" />
                            <TextBox x:Name="VarFilterBox" Grid.Column="2"
                                     Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="5,3" FontSize="12" />
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="4" Padding="2">
                            <Grid>
                                <ListBox x:Name="VarList" Background="Transparent" BorderThickness="0"
                                         SelectionMode="Extended"
                                         Foreground="{StaticResource Fg}" FontSize="13"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                <!-- Estado vacío: nunca una lista en blanco sin decir qué falta ni cómo salir. -->
                                <TextBlock x:Name="VarEmptyHint" Visibility="Collapsed"
                                           Foreground="{StaticResource FgMuted}" FontSize="12"
                                           TextWrapping="Wrap" MaxWidth="420"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Text="{loc:Translate Config.VarsEmpty}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="VarNewBtn"     Content="{loc:Translate Config.VarsNew}"     MinWidth="100" />
                            <Button x:Name="VarEditBtn"    Content="{loc:Translate Config.VarsEdit}"    MinWidth="100" />
                            <Button x:Name="VarDefaultBtn" Content="{loc:Translate Config.VarsDefault}" MinWidth="150" />
                            <Button x:Name="VarDeleteBtn"  Content="{loc:Translate Config.VarsDelete}"  MinWidth="90"
                                    Foreground="{StaticResource Danger}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Camino de TECLADO para mover/copiar. El drag&drop es el gesto rápido, pero es
                     sólo-mouse: sin esta fila, mover una variable sería imposible sin el mouse. -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Translate Config.VarsTargetLabel}" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMuted}" FontSize="12" Margin="0,0,8,0" />
                    <ComboBox x:Name="VarTargetCombo" Width="260" Margin="0,0,10,0" />
                    <Button x:Name="VarMoveBtn" Content="{loc:Translate Config.VarsMove}" MinWidth="130" />
                    <Button x:Name="VarCopyBtn" Content="{loc:Translate Config.VarsCopy}" MinWidth="130" />
                    <!-- Qué quedó cargado con Ctrl+C / Ctrl+X. Sin esto el atajo es MUDO y "copié
                         cuatro" se lee igual que "no copié nada" hasta que el pegado sale mal. -->
                    <TextBlock x:Name="VarClipHint" VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{StaticResource FgMuted}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ===== Pestaña COMANDOS (servicios) =====
             Trilliza de Espacios y Variables, y el tercer vértice del mismo problema: Espacios
             arregla la JERARQUÍA, Variables el CONTENIDO de paths, ésta el CONTENIDO de comandos.
             Hasta acá los servicios sólo se podían tocar desde la ventana del atajo (Win+Numpad+),
             que muestra UN scope por vez y sólo edita el propio — o sea que corregir un comando
             cargado en el scope equivocado era borrarlo y re-tipearlo del otro lado, con sus cuatro
             campos. Misma estructura de dos paneles y por el mismo motivo: mover tiene origen y
             destino, y los dos tienen que estar a la vista. -->
        <TabItem Tag="⏩" Header="{loc:Translate Config.CmdsTab}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                           Text="{loc:Translate Config.CmdsTitle}" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="{loc:Translate Config.CmdsHint}" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Panel izquierdo: los scopes. AllowDrop porque CADA fila es un destino. -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{loc:Translate Config.VarsScopesHeader}"
                                   Foreground="{StaticResource FgMuted}" FontSize="11" Margin="2,0,0,5" />
                        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="4" Padding="2">
                            <ListBox x:Name="CmdScopeList" Background="Transparent" BorderThickness="0"
                                     AllowDrop="True"
                                     Foreground="{StaticResource Fg}" FontSize="13"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Border>
                    </Grid>

                    <!-- Panel derecho: los comandos del scope elegido. -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CmdScopeHeader" Grid.Column="0" VerticalAlignment="Center"
                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{loc:Translate Config.VarsFilterLabel}"
                                       VerticalAlignment="Center" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,6,0" />
                            <TextBox x:Name="CmdFilterBox" Grid.Column="2"
                                     Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="5,3" FontSize="12" />
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="4" Padding="2">
                            <Grid>
                                <ListBox x:Name="CmdList" Background="Transparent" BorderThickness="0"
                                         SelectionMode="Extended"
                                         Foreground="{StaticResource Fg}" FontSize="13"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                <!-- Estado vacío: nunca una lista en blanco sin decir qué falta ni cómo salir. -->
                                <TextBlock x:Name="CmdEmptyHint" Visibility="Collapsed"
                                           Foreground="{StaticResource FgMuted}" FontSize="12"
                                           TextWrapping="Wrap" MaxWidth="420"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Text="{loc:Translate Config.CmdsEmpty}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="CmdNewBtn"    Content="{loc:Translate Config.VarsNew}"   MinWidth="100" />
                            <Button x:Name="CmdEditBtn"   Content="{loc:Translate Config.VarsEdit}"  MinWidth="100" />
                            <Button x:Name="CmdAutoBtn"   Content="{loc:Translate Config.CmdsAutoOn}" MinWidth="170" />
                            <Button x:Name="CmdDeleteBtn" Content="{loc:Translate Config.VarsDelete}" MinWidth="90"
                                    Foreground="{StaticResource Danger}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Camino de TECLADO para mover/copiar, igual que en Variables: el drag&drop es el
                     gesto rápido pero es sólo-mouse. -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Translate Config.VarsTargetLabel}" VerticalAlignment="Center"
                               Foreground="{StaticResource FgMuted}" FontSize="12" Margin="0,0,8,0" />
                    <ComboBox x:Name="CmdTargetCombo" Width="260" Margin="0,0,10,0" />
                    <Button x:Name="CmdMoveBtn" Content="{loc:Translate Config.VarsMove}" MinWidth="130" />
                    <Button x:Name="CmdCopyBtn" Content="{loc:Translate Config.VarsCopy}" MinWidth="130" />
                    <TextBlock x:Name="CmdClipHint" VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{StaticResource FgMuted}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ===== Pestaña APLICACIONES ===== -->
        <TabItem Tag="🧩" Header="{loc:Translate Config.AppsTab}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                           Text="{loc:Translate Config.AppsTitle}" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="{loc:Translate Config.AppsHint}" />

                <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="4" Padding="2">
                    <ListBox x:Name="AppsList" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource Fg}" FontSize="13"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Border>

                <!-- Alta -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="AppNameBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                             BorderBrush="#444" Padding="6,4" Margin="0,0,6,0" VerticalContentAlignment="Center"
                             ToolTip="{loc:Translate Config.AppNameTooltip}" />
                    <TextBox Grid.Column="1" x:Name="AppExeBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                             BorderBrush="#444" Padding="6,4" Margin="0,0,6,0" VerticalContentAlignment="Center"
                             ToolTip="{loc:Translate Config.AppExeTooltip}" />
                    <TextBox Grid.Column="2" x:Name="AppArgsBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                             BorderBrush="#444" Padding="6,4" VerticalContentAlignment="Center"
                             ToolTip="{loc:Translate Config.AppArgsTooltip}" />
                </Grid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                    <Button x:Name="AppAddBtn"    Content="{loc:Translate Config.Add}" MinWidth="100" Padding="10,4" Margin="0,0,6,0" />
                    <Button x:Name="AppRemoveBtn" Content="{loc:Translate Config.RemoveSelected}" MinWidth="150" Padding="10,4" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ===== Pestaña PROTECCIONES ===== -->
        <TabItem Tag="🛡️" Header="{loc:Translate Config.ProtectionsTab}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                           Text="{loc:Translate Config.ProtectionsTitle}" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="{loc:Translate Config.ProtectionsHint}" />

                <!-- Selector de desk + toggle Protegido -->
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Translate Config.DesktopLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" x:Name="ProtDeskCombo" Background="#2A2A2A"
                              Foreground="{StaticResource Fg}" BorderBrush="#444" />
                    <CheckBox Grid.Column="2" x:Name="ProtectedChk" Content="{loc:Translate Config.Protected}"
                              Foreground="{StaticResource Fg}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </Grid>

                <TextBlock Grid.Row="3" x:Name="ProtHint" Foreground="{StaticResource FgMuted}"
                           FontSize="11" FontStyle="Italic" Margin="0,0,0,8" Visibility="Collapsed"
                           Text="{loc:Translate Config.ProtHint}" />

                <!-- Dos columnas: permitidas | abiertas -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Permitidas -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Translate Config.AllowedApps}"
                               FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Panel}"
                            CornerRadius="4" Padding="2">
                        <ListBox x:Name="WhitelistBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Fg}" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Border>
                    <Button Grid.Row="2" Grid.Column="0" x:Name="WlRemoveBtn" Content="{loc:Translate Config.Remove}"
                            Margin="0,6,0,0" HorizontalAlignment="Left" />

                    <!-- Abiertas -->
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Translate Config.OpenApps}"
                               FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource Panel}"
                            CornerRadius="4" Padding="2">
                        <ListBox x:Name="RunningBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Fg}" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Border>
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="WlAddFromRunningBtn" Content="{loc:Translate Config.AddFromRunning}" />
                        <Button x:Name="RunningRefreshBtn" Content="{loc:Translate Config.Refresh}" MinWidth="100" />
                    </StackPanel>
                </Grid>

                <!-- Alta manual -->
                <Grid Grid.Row="5" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Translate Config.ManualLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" x:Name="WlManualBox" Background="#2A2A2A"
                             Foreground="{StaticResource Fg}" BorderBrush="#444" Padding="6,4"
                             VerticalContentAlignment="Center" ToolTip="{loc:Translate Config.ProcessNameTooltip}" />
                    <Button Grid.Column="2" x:Name="WlAddManualBtn" Content="{loc:Translate Config.Add}" Margin="6,0,0,0" />
                </Grid>
            </Grid>
        </TabItem>

        <!-- ===== Pestaña ANCLAJES ===== -->
        <TabItem Tag="📌" Header="{loc:Translate Config.PinsTab}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold" Text="{loc:Translate Config.PinnedApps}" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="{loc:Translate Config.PinsHint}" />

                <!-- Dos columnas: ancladas | anclar nueva -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Izquierda: ancladas actuales -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Translate Config.Pinned}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Panel}"
                            CornerRadius="4" Padding="2">
                        <ListBox x:Name="PinnedBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Fg}" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Border>
                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="UnpinBtn" Content="{loc:Translate Config.Unpin}" />
                        <Button x:Name="UnpinAllBtn" Content="{loc:Translate Config.UnpinAll}" MinWidth="120" />
                    </StackPanel>

                    <!-- Derecha: anclar una app -->
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Translate Config.PinAnApp}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid Grid.Row="1" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Translate Config.PinTo}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" x:Name="PinDeskCombo" Background="#2A2A2A"
                                      Foreground="{StaticResource Fg}" BorderBrush="#444" />
                        </Grid>
                        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="4" Padding="2">
                            <ListBox x:Name="PinRunningBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Fg}" FontSize="13"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="PinAddFromRunningBtn" Content="{loc:Translate Config.PinSelected}" />
                        <Button x:Name="PinRunningRefreshBtn" Content="{loc:Translate Config.Refresh}" MinWidth="100" />
                    </StackPanel>
                </Grid>

                <!-- Alta manual (usa el escritorio elegido arriba) -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Translate Config.ManualLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" x:Name="PinManualBox" Background="#2A2A2A"
                             Foreground="{StaticResource Fg}" BorderBrush="#444" Padding="6,4"
                             VerticalContentAlignment="Center" ToolTip="{loc:Translate Config.PinManualTooltip}" />
                    <Button Grid.Column="2" x:Name="PinAddManualBtn" Content="{loc:Translate Config.Pin}" Margin="6,0,0,0" />
                </Grid>
            </Grid>
        </TabItem>

        <!-- ===== Pestaña TAREAS ===== -->
        <TabItem Tag="📋" Header="{loc:Translate Config.TasksTab}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold" Text="{loc:Translate Config.TaskAccounts}" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="{loc:Translate Config.TaskAccountsHint}" />

                <!-- Master-detail: lista de cuentas (izq) + editor (der) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ── IZQ: lista + acciones ── -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="4" Padding="2">
                            <ListBox x:Name="AccountsList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Fg}" FontSize="13"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Border>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="AccountAddBtn" Content="{loc:Translate Config.AddAccount}" MinWidth="92" />
                            <Button x:Name="AccountRemoveBtn" Content="{loc:Translate Config.RemoveAccount}" MinWidth="92" />
                        </StackPanel>
                    </Grid>

                    <!-- ── DER: editor de la cuenta seleccionada ── -->
                    <Border Grid.Column="1" x:Name="AccountEditorPanel" Background="{StaticResource Panel}"
                            CornerRadius="4" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                          <StackPanel>
                            <TextBlock Text="{loc:Translate Config.AccountName}" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="AcctNameBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     ToolTip="{loc:Translate Config.AccountNameTooltip}" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{loc:Translate Config.AccountKind}" Foreground="{StaticResource FgMuted}"
                                               FontSize="11" Margin="0,0,0,2" />
                                    <ComboBox x:Name="AcctKindCombo" Background="#2A2A2A"
                                              Foreground="{StaticResource Fg}" BorderBrush="#444" />
                                </StackPanel>
                                <CheckBox x:Name="AcctEnabledChk" Grid.Column="1" Content="{loc:Translate Config.AccountEnabled}"
                                          VerticalAlignment="Bottom" Margin="0,0,0,4" />
                            </Grid>

                <!-- Paneles de credenciales (uno visible por vez según el Kind de la cuenta) -->
                <StackPanel>

                    <!-- Vikunja -->
                    <Border x:Name="VikunjaPanel" Background="{StaticResource Panel}" CornerRadius="4"
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Vikunja" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <TextBlock Text="{loc:Translate Config.VikunjaUrl}"
                                       Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="VkUrlBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     ToolTip="{loc:Translate Config.VikunjaUrlTooltip}" />

                            <TextBlock Text="{loc:Translate Config.VikunjaUser}" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="VkUserBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     ToolTip="{loc:Translate Config.VikunjaUserTooltip}" />

                            <TextBlock Text="{loc:Translate Config.VikunjaToken}" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="VkTokenBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" VerticalContentAlignment="Center"
                                     ToolTip="{loc:Translate Config.VikunjaTokenTooltip}" />

                            <TextBlock Foreground="{StaticResource FgMuted}" FontSize="11" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{loc:Translate Config.TokenStorageWarning}" />
                        </StackPanel>
                    </Border>

                    <!-- JIRA -->
                    <Border x:Name="JiraPanel" Background="{StaticResource Panel}" CornerRadius="4"
                            Padding="12" Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Config.JiraTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <TextBlock Text="{loc:Translate Config.JiraUrl}"
                                       Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="JiraUrlBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center" />

                            <TextBlock Text="{loc:Translate Config.JiraEmail}" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="JiraEmailBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center" />

                            <TextBlock Text="{loc:Translate Config.JiraToken}" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="JiraTokenBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" VerticalContentAlignment="Center" />

                            <TextBlock Foreground="{StaticResource FgMuted}" FontSize="11" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{loc:Translate Config.JiraNotReady}" />
                        </StackPanel>
                    </Border>

                    <!-- Trello -->
                    <Border x:Name="TrelloPanel" Background="{StaticResource Panel}" CornerRadius="4"
                            Padding="12" Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Trello" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <TextBlock Text="{loc:Translate Config.TrelloApiKey}" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="TrelloKeyBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     ToolTip="{loc:Translate Config.TrelloApiKeyTooltip}" />

                            <TextBlock Text="{loc:Translate Config.TrelloToken}" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="TrelloTokenBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     ToolTip="{loc:Translate Config.TrelloTokenTooltip}" />

                            <TextBlock Text="{loc:Translate Config.TrelloIgnoredLists}"
                                       Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="TrelloIgnoredListsBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" MinHeight="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     ToolTip="{loc:Translate Config.TrelloIgnoredListsTooltip}" />

                            <TextBlock Foreground="{StaticResource FgMuted}" FontSize="11" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{loc:Translate Config.TrelloStorageWarning}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                          </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Estado de la prueba -->
                <TextBlock Grid.Row="3" x:Name="TaskTestStatus" Foreground="{StaticResource FgMuted}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />

                <!-- Acciones -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="TaskTestBtn" Content="{loc:Translate Config.TestAccount}" MinWidth="140" Padding="10,4" Margin="0,0,6,0" />
                    <Button x:Name="TaskSaveBtn" Content="{loc:Translate Config.Save}" MinWidth="100" Padding="10,4"
                            Background="{StaticResource Accent}" Foreground="#10222A" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ===== Pestaña ATENCIÓN ===== -->
        <TabItem Tag="🔔" Header="{loc:Translate Config.AttentionTab}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold" Text="{loc:Translate Config.AttentionTitle}" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,12"
                           Text="{loc:Translate Config.AttentionHint}" />

                <!-- Toggle de la feature entera -->
                <CheckBox Grid.Row="2" x:Name="AttnEnabledChk" Margin="0,0,0,4"
                          Content="{loc:Translate Config.AttentionEnabled}" />

                <!-- Cuerpo: sonido -->
                <StackPanel Grid.Row="3" Margin="0,8,0,0">

                    <CheckBox x:Name="AttnSoundEnabledChk" Margin="0,0,0,14"
                              Content="{loc:Translate Config.SoundEnabled}" />

                    <!-- Te necesita -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Translate Config.AttnUrgentLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Translate Config.AttnUrgentSub}" Foreground="{StaticResource FgMuted}" FontSize="11" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="AttnSoundUrgentCombo" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="AttnBrowseUrgentBtn" Content="📁" MinWidth="38" ToolTip="{loc:Translate Config.BrowseWavTooltip}" />
                            <Button x:Name="AttnTestUrgentBtn" Content="{loc:Translate Config.TestSound}" MinWidth="90" />
                        </StackPanel>
                    </Grid>

                    <!-- Tarea lista -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Translate Config.AttnDoneLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Translate Config.AttnDoneSub}" Foreground="{StaticResource FgMuted}" FontSize="11" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="AttnSoundDoneCombo" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="AttnBrowseDoneBtn" Content="📁" MinWidth="38" ToolTip="{loc:Translate Config.BrowseWavTooltip}" />
                            <Button x:Name="AttnTestDoneBtn" Content="{loc:Translate Config.TestSound}" MinWidth="90" />
                        </StackPanel>
                    </Grid>

                    <!-- Volumen -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Translate Config.Volume}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" x:Name="AttnVolumeSlider" Minimum="0" Maximum="100"
                                VerticalAlignment="Center" TickFrequency="10" IsSnapToTickEnabled="False" />
                        <TextBlock Grid.Column="2" x:Name="AttnVolumeText" Text="100%" VerticalAlignment="Center"
                                   TextAlignment="Right" Foreground="{StaticResource FgMuted}" />
                    </Grid>

                    <!-- Gate de mismo desk: toast y sonido por SEPARADO -->
                    <TextBlock Text="{loc:Translate Config.SameDeskGate}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="22,0,0,0">
                        <CheckBox x:Name="AttnSameDeskToastChk" Content="{loc:Translate Config.ShowToast}" Margin="0,0,28,0" />
                        <CheckBox x:Name="AttnSameDeskSoundChk" Content="{loc:Translate Config.PlaySound}" />
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource FgMuted}" FontSize="11" FontStyle="Italic"
                               TextWrapping="Wrap" Margin="22,4,0,0"
                               Text="{loc:Translate Config.SameDeskGateHint}" />
                </StackPanel>

                <!-- Acciones -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="AttnSaveBtn" Content="{loc:Translate Config.Save}" MinWidth="100" Padding="10,4"
                            Background="{StaticResource Accent}" Foreground="#10222A" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ===== Pestaña NAVEGADOR ===== -->
        <TabItem Tag="🌐" Header="{loc:Translate Config.BrowserTab}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold" Text="{loc:Translate Config.BrowserTitle}" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,12"
                           Text="{loc:Translate Config.BrowserHint}" />

                <!-- Toggle de la feature -->
                <CheckBox Grid.Row="2" x:Name="BrowserEnabledChk" Margin="0,0,0,4"
                          Content="{loc:Translate Config.BrowserEnabled}" />

                <StackPanel Grid.Row="3" Margin="0,8,0,0">

                    <!-- Estado actual -->
                    <Border Background="{StaticResource Panel}" CornerRadius="4" Padding="10,8" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="BrowserStatusText" Foreground="{StaticResource Fg}" FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="BrowserStatusHint" Foreground="{StaticResource FgMuted}" FontSize="11"
                                       FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Navegador real -->
                    <TextBlock Text="{loc:Translate Config.RealBrowser}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Foreground="{StaticResource FgMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="{loc:Translate Config.RealBrowserHint}" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="BrowserPathBox" VerticalAlignment="Center"
                                 FontFamily="Consolas" Margin="0,0,8,0" />
                        <Button Grid.Column="1" x:Name="BrowserBrowseBtn" Content="{loc:Translate Config.Browse}" MinWidth="100" />
                    </Grid>

                    <!-- Paso manual del default -->
                    <TextBlock Text="{loc:Translate Config.BrowserSetupRequired}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Foreground="{StaticResource FgMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="{loc:Translate Config.BrowserSetupHint}" />
                    <Button x:Name="BrowserOpenSettingsBtn" Content="{loc:Translate Config.OpenDefaultApps}"
                            HorizontalAlignment="Left" MinWidth="280" Padding="12,6" />
                </StackPanel>

                <!-- Acciones -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="BrowserSaveBtn" Content="{loc:Translate Config.Save}" MinWidth="100" Padding="10,4"
                            Background="{StaticResource Accent}" Foreground="#10222A" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ===== Pestaña GENERAL ===== -->
        <TabItem Tag="⚙️" Header="{loc:Translate General.Title}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold" Text="{loc:Translate General.Title}" />

                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           Margin="0,8,0,4" Text="{loc:Translate General.DataPathLabel}" />
                <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="4" Padding="8,6">
                    <TextBlock x:Name="DataPathText" Foreground="{StaticResource Fg}" FontSize="12"
                               FontFamily="Consolas" TextWrapping="Wrap" />
                </Border>

                <!-- Selector de idioma (i18n). El cambio se aplica al reiniciar (modelo por reinicio). -->
                <StackPanel Grid.Row="3" Margin="0,16,0,0" VerticalAlignment="Top">
                    <TextBlock Text="{loc:Translate General.Language}" Foreground="{StaticResource Fg}"
                               FontSize="13" FontWeight="SemiBold" />
                    <ComboBox x:Name="LanguageCombo" Width="220" HorizontalAlignment="Left"
                              Margin="0,6,0,0" Padding="6,4" FontSize="13" />
                    <TextBlock Text="{loc:Translate General.LanguageHint}" Foreground="{StaticResource FgMuted}"
                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Zona de riesgo -->
                <Border Grid.Row="4" BorderBrush="{StaticResource Danger}" BorderThickness="1"
                        CornerRadius="4" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate General.RiskZone}" Foreground="{StaticResource Danger}"
                                   FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Foreground="{StaticResource FgMuted}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,6,0,10"
                                   Text="{loc:Translate General.ResetWarning}" />
                        <Button x:Name="ResetAllBtn" Content="{loc:Translate General.ResetButton}"
                                HorizontalAlignment="Left" MinWidth="240" Padding="12,6"
                                Background="{StaticResource Danger}" Foreground="#FFFFFF" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

    </TabControl>
</Window>
