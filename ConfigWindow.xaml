<Window x:Class="AmpzDesktopBooster.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ampz Desktop Booster — Configuración"
        Width="1029" Height="840"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Fg"      Color="#F2F2F2" />
        <SolidColorBrush x:Key="FgMuted" Color="#9A9A9A" />
        <SolidColorBrush x:Key="Panel"   Color="#161616" />
        <SolidColorBrush x:Key="Accent"  Color="#4FC3F7" />
        <SolidColorBrush x:Key="Danger"  Color="#E5534B" />

        <!-- TextBlock global -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
        </Style>

        <!-- CheckBox global -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Button: dark rounded con hover/press/disabled -->
        <Style TargetType="Button">
            <Setter Property="Padding"          Value="10,5" />
            <Setter Property="Margin"           Value="0,0,6,0" />
            <Setter Property="MinWidth"         Value="80" />
            <Setter Property="Foreground"       Value="{StaticResource Fg}" />
            <Setter Property="Background"       Value="#2D2D2D" />
            <Setter Property="BorderBrush"      Value="#484848" />
            <Setter Property="BorderThickness"  Value="1" />
            <Setter Property="Cursor"           Value="Hand" />
            <Setter Property="FontSize"         Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"   Value="#3C3C3C" />
                                <Setter TargetName="bd" Property="BorderBrush"  Value="#606060" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222222" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem: hover + selección en acento -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Padding"    Value="8,5" />
            <Setter Property="Margin"     Value="2,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#282828" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A3A4A" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox: el template default tira el área de selección con SystemColors.WindowBrush
             (blanco) IGNORANDO el Foreground/Background que setees inline → letras blancas sobre
             fondo blanco. Sólo se arregla retempleteando. Mantenemos el header como ToggleButton
             entero para que click en cualquier punto abra el dropdown (no sólo en la flecha). -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground"      Value="{StaticResource Fg}" />
            <Setter Property="Background"      Value="#2A2A2A" />
            <Setter Property="BorderBrush"     Value="#444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="8,4" />
            <Setter Property="MinHeight"       Value="28" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="22" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter x:Name="header" Grid.Column="0"
                                                                  Margin="8,0,0,0" VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left" />
                                                <Path Grid.Column="1" Fill="{StaticResource Fg}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 8 0 L 4 5 Z" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#606060" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- El selected item se inyecta en el header del ToggleButton via Content -->
                            <ContentPresenter IsHitTestVisible="False" Margin="8,0,30,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="#2A2A2A" BorderBrush="#444" BorderThickness="1" CornerRadius="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem: el popup default de WPF tira items con fondo CLARO que matan la lectura
             sobre el tema oscuro. Mismo criterio que el ListBoxItem de arriba: hover gris, selección
             en acento, foreground claro siempre. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Padding"    Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3C3C3C" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A3A4A" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl: sin borde, fondo neutro -->
        <Style TargetType="TabControl">
            <Setter Property="Background"       Value="#1E1E1E" />
            <Setter Property="BorderThickness"  Value="0" />
            <Setter Property="Padding"          Value="0" />
        </Style>

        <!-- TabItem: underline accent en pestaña activa -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding"    Value="14,9" />
            <Setter Property="FontSize"   Value="12" />
            <Setter Property="Cursor"     Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}" Margin="0,0,2,0">
                            <ContentPresenter x:Name="cp"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cp" Property="TextBlock.Foreground"
                                        Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{StaticResource Accent}" />
                                <Setter TargetName="cp" Property="TextBlock.Foreground"
                                        Value="{StaticResource Fg}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl x:Name="Tabs" Background="#1E1E1E" BorderThickness="0" Margin="8" HorizontalContentAlignment="Center" UseLayoutRounding="False">

        <!-- ===== Pestaña DESKTOPS ===== -->
        <TabItem Header="Desktops">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                           Text="Escritorios gestionados" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="El orden define el índice del escritorio. La app crea los que falten (Win+Ctrl+D) y renombra los primeros N con estos nombres. Renombrar NO mueve ventanas." />

                <!-- Alta: textbox + Agregar -->
                <Grid Grid.Row="1" Margin="0,0,0,0" VerticalAlignment="Bottom" Visibility="Collapsed" />

                <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="4" Padding="2">
                    <ListBox x:Name="DeskList" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource Fg}" FontSize="13"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Border>

                <!-- Reordenar / editar -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="UpBtn"     Content="↑ Subir" />
                    <Button x:Name="DownBtn"   Content="↓ Bajar" />
                    <Button x:Name="RenameBtn" Content="Renombrar" />
                    <Button x:Name="RemoveBtn" Content="Quitar" />
                </StackPanel>

                <!-- Alta nueva -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="NameBox" Width="320" Background="#2A2A2A"
                             Foreground="{StaticResource Fg}" BorderBrush="#444" Padding="6,4"
                             VerticalContentAlignment="Center" />
                    <Button x:Name="AddBtn" Content="Agregar" Margin="6,0,0,0" />
                </StackPanel>

                <!-- Footer: autocreate + acciones -->
                <Grid Grid.Row="5" Margin="0,14,0,0">
                    <CheckBox x:Name="AutoCreateChk" Foreground="{StaticResource Fg}"
                              VerticalAlignment="Center"
                              Content="Crear escritorios faltantes al iniciar" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ApplyNowBtn" Content="Crear faltantes ahora" MinWidth="150" />
                        <Button x:Name="SaveBtn" Content="Guardar" MinWidth="100"
                                Background="{StaticResource Accent}" Foreground="#10222A" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ===== Pestaña APLICACIONES ===== -->
        <TabItem Header="Aplicaciones">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                           Text="Apps para “Abrir con” (Win+F2)" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="VS Code, Warp, WSL, Claude/OpenCode CLI se detectan solas si están instaladas. Acá agregás las tuyas. En Argumentos, usá {path} donde va la carpeta (si lo omitís, se pasa la carpeta como argumento)." />

                <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="4" Padding="2">
                    <ListBox x:Name="AppsList" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource Fg}" FontSize="13"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Border>

                <!-- Alta -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="AppNameBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                             BorderBrush="#444" Padding="6,4" Margin="0,0,6,0" VerticalContentAlignment="Center"
                             ToolTip="Nombre" />
                    <TextBox Grid.Column="1" x:Name="AppExeBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                             BorderBrush="#444" Padding="6,4" Margin="0,0,6,0" VerticalContentAlignment="Center"
                             ToolTip="Ruta al ejecutable" />
                    <TextBox Grid.Column="2" x:Name="AppArgsBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                             BorderBrush="#444" Padding="6,4" VerticalContentAlignment="Center"
                             ToolTip="Argumentos (opcional, {path})" />
                </Grid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                    <Button x:Name="AppAddBtn"    Content="Agregar" MinWidth="100" Padding="10,4" Margin="0,0,6,0" />
                    <Button x:Name="AppRemoveBtn" Content="Quitar seleccionada" MinWidth="150" Padding="10,4" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ===== Pestaña PROTECCIONES ===== -->
        <TabItem Header="Protecciones">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                           Text="Protección de escritorios" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="Un escritorio protegido solo admite las apps de su lista; cualquier otra que aparezca ahí se manda a MAIN. Solo se pueden proteger los que NO son MAIN ni DESK+ (esos son de proyecto). Los cambios se guardan al instante y se aplican al entrar al escritorio." />

                <!-- Selector de desk + toggle Protegido -->
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Escritorio:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" x:Name="ProtDeskCombo" Background="#2A2A2A"
                              Foreground="{StaticResource Fg}" BorderBrush="#444" />
                    <CheckBox Grid.Column="2" x:Name="ProtectedChk" Content="Protegido"
                              Foreground="{StaticResource Fg}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </Grid>

                <TextBlock Grid.Row="3" x:Name="ProtHint" Foreground="{StaticResource FgMuted}"
                           FontSize="11" FontStyle="Italic" Margin="0,0,0,8" Visibility="Collapsed"
                           Text="Protegé el escritorio para administrar su lista de apps permitidas." />

                <!-- Dos columnas: permitidas | abiertas -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Permitidas -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Apps permitidas"
                               FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Panel}"
                            CornerRadius="4" Padding="2">
                        <ListBox x:Name="WhitelistBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Fg}" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Border>
                    <Button Grid.Row="2" Grid.Column="0" x:Name="WlRemoveBtn" Content="Quitar"
                            Margin="0,6,0,0" HorizontalAlignment="Left" />

                    <!-- Abiertas -->
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Apps abiertas"
                               FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource Panel}"
                            CornerRadius="4" Padding="2">
                        <ListBox x:Name="RunningBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Fg}" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Border>
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="WlAddFromRunningBtn" Content="◀ Agregar" />
                        <Button x:Name="RunningRefreshBtn" Content="↻ Refrescar" MinWidth="100" />
                    </StackPanel>
                </Grid>

                <!-- Alta manual -->
                <Grid Grid.Row="5" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Manual:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" x:Name="WlManualBox" Background="#2A2A2A"
                             Foreground="{StaticResource Fg}" BorderBrush="#444" Padding="6,4"
                             VerticalContentAlignment="Center" ToolTip="Nombre del proceso, ej: brave.exe" />
                    <Button Grid.Column="2" x:Name="WlAddManualBtn" Content="Agregar" Margin="6,0,0,0" />
                </Grid>
            </Grid>
        </TabItem>

        <!-- ===== Pestaña ANCLAJES ===== -->
        <TabItem Header="Anclajes">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold" Text="Apps ancladas" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="Una app anclada se mueve y maximiza en su escritorio cada vez que aparece en otro. El anclaje es por NOMBRE de escritorio, así que reordenarlos no lo rompe. Los cambios se guardan al instante." />

                <!-- Dos columnas: ancladas | anclar nueva -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Izquierda: ancladas actuales -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ancladas" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Panel}"
                            CornerRadius="4" Padding="2">
                        <ListBox x:Name="PinnedBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Fg}" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Border>
                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="UnpinBtn" Content="Desanclar" />
                        <Button x:Name="UnpinAllBtn" Content="Desanclar todo" MinWidth="120" />
                    </StackPanel>

                    <!-- Derecha: anclar una app -->
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Anclar una app" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid Grid.Row="1" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="A:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" x:Name="PinDeskCombo" Background="#2A2A2A"
                                      Foreground="{StaticResource Fg}" BorderBrush="#444" />
                        </Grid>
                        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="4" Padding="2">
                            <ListBox x:Name="PinRunningBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Fg}" FontSize="13"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="PinAddFromRunningBtn" Content="Anclar ▶" />
                        <Button x:Name="PinRunningRefreshBtn" Content="↻ Refrescar" MinWidth="100" />
                    </StackPanel>
                </Grid>

                <!-- Alta manual (usa el escritorio elegido arriba) -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Manual:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" x:Name="PinManualBox" Background="#2A2A2A"
                             Foreground="{StaticResource Fg}" BorderBrush="#444" Padding="6,4"
                             VerticalContentAlignment="Center" ToolTip="Nombre del proceso, ej: brave.exe — se ancla al escritorio elegido arriba" />
                    <Button Grid.Column="2" x:Name="PinAddManualBtn" Content="Anclar" Margin="6,0,0,0" />
                </Grid>
            </Grid>
        </TabItem>

        <!-- ===== Pestaña TAREAS ===== -->
        <TabItem Header="Tareas">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold" Text="Cuentas de tareas" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="Conectá uno o varios gestores a la vez (Vikunja, JIRA, Trello). El picker (Win+NumLock) agrega lo de todas las cuentas habilitadas y muestra de qué cuenta vino cada tarea. Sumá una por cliente." />

                <!-- Master-detail: lista de cuentas (izq) + editor (der) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ── IZQ: lista + acciones ── -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="4" Padding="2">
                            <ListBox x:Name="AccountsList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Fg}" FontSize="13"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Border>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="AccountAddBtn" Content="+ Agregar" MinWidth="92" />
                            <Button x:Name="AccountRemoveBtn" Content="− Quitar" MinWidth="92" />
                        </StackPanel>
                    </Grid>

                    <!-- ── DER: editor de la cuenta seleccionada ── -->
                    <Border Grid.Column="1" x:Name="AccountEditorPanel" Background="{StaticResource Panel}"
                            CornerRadius="4" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                          <StackPanel>
                            <TextBlock Text="Nombre" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="AcctNameBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Ej: 'Trello — Cliente Coca'. Lo que ves en el picker." />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Gestor" Foreground="{StaticResource FgMuted}"
                                               FontSize="11" Margin="0,0,0,2" />
                                    <ComboBox x:Name="AcctKindCombo" Background="#2A2A2A"
                                              Foreground="{StaticResource Fg}" BorderBrush="#444" />
                                </StackPanel>
                                <CheckBox x:Name="AcctEnabledChk" Grid.Column="1" Content="Habilitada"
                                          VerticalAlignment="Bottom" Margin="0,0,0,4" />
                            </Grid>

                <!-- Paneles de credenciales (uno visible por vez según el Kind de la cuenta) -->
                <StackPanel>

                    <!-- Vikunja -->
                    <Border x:Name="VikunjaPanel" Background="{StaticResource Panel}" CornerRadius="4"
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Vikunja" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <TextBlock Text="URL de la instancia (sin / final)"
                                       Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="VkUrlBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Ej: https://projects.blaster.com.ar" />

                            <TextBlock Text="Usuario (login)" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="VkUserBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Tu nombre de usuario en Vikunja — necesario para filtrar solo tus tareas" />

                            <TextBlock Text="API token (tk_...)" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="VkTokenBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" VerticalContentAlignment="Center"
                                     ToolTip="Vikunja → Settings → API Tokens" />

                            <TextBlock Foreground="{StaticResource FgMuted}" FontSize="11" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="El token se guarda en texto plano en %APPDATA%\AmpzDesktopBooster\tasks.json. No lo compartas." />
                        </StackPanel>
                    </Border>

                    <!-- JIRA -->
                    <Border x:Name="JiraPanel" Background="{StaticResource Panel}" CornerRadius="4"
                            Padding="12" Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="JIRA  (en preparación)" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <TextBlock Text="URL (https://tuorg.atlassian.net)"
                                       Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="JiraUrlBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center" />

                            <TextBlock Text="Email" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="JiraEmailBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center" />

                            <TextBlock Text="API token" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="JiraTokenBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" VerticalContentAlignment="Center" />

                            <TextBlock Foreground="{StaticResource FgMuted}" FontSize="11" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="El adapter de JIRA todavía no hace fetch — podés guardar las credenciales, pero 'Probar conexión' avisará que está en preparación." />
                        </StackPanel>
                    </Border>

                    <!-- Trello -->
                    <Border x:Name="TrelloPanel" Background="{StaticResource Panel}" CornerRadius="4"
                            Padding="12" Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Trello" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <TextBlock Text="API key" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="TrelloKeyBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Creá un Power-Up en https://trello.com/power-ups/admin → campo 'API key'" />

                            <TextBlock Text="Token" Foreground="{StaticResource FgMuted}"
                                       FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="TrelloTokenBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Generá el token desde el link 'Token' al lado de tu API key" />

                            <TextBlock Text="Listas a ignorar (extras — uno por línea o coma-separados)"
                                       Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,2" />
                            <TextBox x:Name="TrelloIgnoredListsBox" Background="#2A2A2A" Foreground="{StaticResource Fg}"
                                     BorderBrush="#444" Padding="6,4" MinHeight="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     ToolTip="Ej: Hecho, Validado, En review. Match por 'contiene' case-insensitive. Se SUMA a los defaults (done, cancelled, terminado, etc.)" />

                            <TextBlock Foreground="{StaticResource FgMuted}" FontSize="11" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Trae tus tarjetas asignadas de todos los tableros. Filtra automáticamente las que estás marcado como completas Y las que están en listas terminales (done/cancelled + las que agregues acá). La key y el token se guardan en texto plano en %APPDATA%\AmpzDesktopBooster\tasks.json — no los compartas." />
                        </StackPanel>
                    </Border>
                </StackPanel>
                          </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Estado de la prueba -->
                <TextBlock Grid.Row="3" x:Name="TaskTestStatus" Foreground="{StaticResource FgMuted}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />

                <!-- Acciones -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="TaskTestBtn" Content="Probar cuenta" MinWidth="140" Padding="10,4" Margin="0,0,6,0" />
                    <Button x:Name="TaskSaveBtn" Content="Guardar" MinWidth="100" Padding="10,4"
                            Background="{StaticResource Accent}" Foreground="#10222A" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ===== Pestaña GENERAL ===== -->
        <TabItem Header="General">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold" Text="General" />

                <TextBlock Grid.Row="1" Foreground="{StaticResource FgMuted}" FontSize="11"
                           Margin="0,8,0,4" Text="Tu configuración se guarda en:" />
                <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="4" Padding="8,6">
                    <TextBlock x:Name="DataPathText" Foreground="{StaticResource Fg}" FontSize="12"
                               FontFamily="Consolas" TextWrapping="Wrap" />
                </Border>

                <!-- Zona de riesgo -->
                <Border Grid.Row="4" BorderBrush="{StaticResource Danger}" BorderThickness="1"
                        CornerRadius="4" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="⚠ Zona de riesgo" Foreground="{StaticResource Danger}"
                                   FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Foreground="{StaticResource FgMuted}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,6,0,10"
                                   Text="Restablecer borra TODA tu configuración (escritorios, proyectos, pins, protecciones, apps, atajos, widgets y uso) y NO se puede deshacer. La app se reinicia con los valores por defecto." />
                        <Button x:Name="ResetAllBtn" Content="Restablecer toda la configuración"
                                HorizontalAlignment="Left" MinWidth="240" Padding="12,6"
                                Background="{StaticResource Danger}" Foreground="#FFFFFF" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

    </TabControl>
</Window>
