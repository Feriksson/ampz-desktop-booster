<Window x:Class="AmpzDesktopBooster.PortsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate Ports.WindowTitle}"
        Width="900" Height="720"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Mismo estilado de filas oscuras que ProjectPathsWindow: el GridView crea ListViewItems
             que NO heredan el tema del ListView → hay que estilarlos o salen con el tema claro. -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6E6EA" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#262626" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones del footer: mismo patrón de foco visible (celeste) que ProjectPathsWindow. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34505C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A6070" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#262626" />
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="BorderBrush" Value="#333" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="HeaderText" Foreground="#F2F2F2"
                       FontSize="16" FontWeight="SemiBold" Text="{loc:Translate Ports.WindowTitle}" />
            <TextBlock Grid.Row="1" x:Name="SubHeaderText" Foreground="#9A9A9A"
                       FontSize="11" Margin="0,2,0,10" />

            <TextBox Grid.Row="2" x:Name="FilterBox" Background="#2A2A2A" Foreground="#F2F2F2"
                     BorderBrush="#444" Padding="6,4" FontSize="13" Margin="0,0,0,8" />

            <Border Grid.Row="3" Background="#161616" CornerRadius="4" Padding="2">
                <ListView x:Name="PortList" Background="Transparent" BorderThickness="0"
                          Foreground="#E6E6EA" FontSize="13">
                    <ListView.View>
                        <GridView>
                            <!-- Estado como FIGURA real, no emoji: "🟢/⚪" en un GridView se rendean
                                 MONOCROMOS con la fuente por defecto (verde y gris quedan iguales, un
                                 circulito hueco indistinguible). Un Ellipse con Fill atado a IsListening
                                 por DataTrigger es inequívoco y liga al bool directo (INPC garantizado). -->
                            <GridViewColumn Header="{loc:Translate Ports.ColStatus}" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <!-- Apagado: gris tenue. -->
                                                    <Setter Property="Fill" Value="#4A4A52" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                            <Setter Property="Fill" Value="#3FB950" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{loc:Translate Ports.ColTitle}" Width="300"
                                            DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="{loc:Translate Ports.ColPort}" Width="90"
                                            DisplayMemberBinding="{Binding Port}" />
                            <GridViewColumn Header="{loc:Translate Ports.ColUrl}" Width="330"
                                            DisplayMemberBinding="{Binding LocalhostUrl}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <TextBlock Grid.Row="4" Foreground="#6E6E78" FontSize="10" Margin="0,8,0,0"
                       TextWrapping="Wrap" Text="{loc:Translate Ports.Hints}" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="AddBtn"       Content="{loc:Translate Ports.BtnAdd}" MinWidth="90" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="EditBtn"      Content="{loc:Translate Ports.BtnRename}" MinWidth="100" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="DeleteBtn"    Content="{loc:Translate Ports.BtnDelete}" MinWidth="70" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="CopyLocalBtn" Content="{loc:Translate Ports.BtnCopyLocal}" MinWidth="130" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="CopyIpBtn"    Content="{loc:Translate Ports.BtnCopyIp}" MinWidth="130" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="QrBtn"        Content="{loc:Translate Ports.BtnQr}" MinWidth="70" Margin="0,0,6,0" Padding="10,4" />
                <Button x:Name="CloseBtn"     Content="{loc:Translate Ports.BtnClose}" MinWidth="70" HorizontalAlignment="Right" Padding="10,4" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
