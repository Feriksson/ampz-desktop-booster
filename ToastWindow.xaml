<Window x:Class="AmpzDesktopBooster.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate Toast.Title}"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Toast: barra de color a la izquierda (acento por tipo) + 2 líneas: detalle gris arriba,
         título fuerte abajo. Mismo lenguaje visual que el overlay/legacy.
         El Margin del Border deja aire para que la sombra (DropShadow) no se recorte contra el borde
         de la ventana. Borde claro 1px + sombra → la tarjeta se DESPEGA del fondo aunque la app de
         atrás sea oscura (antes se fundía y no se distinguía dónde empezaba el toast). -->
    <Border x:Name="Card" Background="#F21D1D1D" CornerRadius="12" Padding="0" Margin="16"
            BorderBrush="#40FFFFFF" BorderThickness="1"
            MinWidth="420" MaxWidth="640">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="0" Opacity="0.55" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="AccentBar" Grid.Column="0" Background="#4FC3F7"
                    CornerRadius="12,0,0,12" />

            <StackPanel Grid.Column="1" Margin="22,16">
                <TextBlock x:Name="DetailText" FontFamily="Segoe UI" FontSize="12"
                           Foreground="#888888" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TitleText" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"
                           Foreground="#F2F2F2" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                <!-- Tercera línea OPCIONAL (Collapsed por defecto): la usa el toast de atención para
                     el nombre del proyecto en su propio renglón. Los demás toasts no la pasan → ni se ve. -->
                <TextBlock x:Name="ExtraText" FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="#C9C9C9" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
