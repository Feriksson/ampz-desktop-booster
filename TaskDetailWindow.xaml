<Window x:Class="AmpzDesktopBooster.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarea activa"
        Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True">

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <StackPanel>
            <!-- Identifier + proyecto: la "metadata" chica, arriba y tenue. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock x:Name="IdText" Foreground="#4FC3F7" FontFamily="Segoe UI" FontSize="11"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="ProjectText" Foreground="#6E6E78" FontFamily="Segoe UI" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <!-- El texto completo de la tarea (en la barra va recortado; acá entero, con wrap). -->
            <TextBlock x:Name="TitleText" Foreground="#F2F2F2" FontFamily="Segoe UI" FontSize="14"
                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="UnpinBtn"  Content="Desanclar"  Width="92" Height="28" Margin="0,0,8,0" />
                <Button x:Name="PickBtn"   Content="Elegir otra" Width="92" Height="28" Margin="0,0,8,0" />
                <Button x:Name="OpenBtn"   Content="Abrir tarea" Width="100" Height="28" />
            </StackPanel>

            <TextBlock Foreground="#6E6E78" FontFamily="Segoe UI" FontSize="10" Margin="0,10,0,0"
                       Text="Esc: cerrar" />
        </StackPanel>
    </Border>
</Window>
