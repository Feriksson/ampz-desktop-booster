<Window x:Class="AmpzDesktopBooster.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate TaskDetail.WindowTitle}"
        Width="820" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True">

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <StackPanel>
            <!-- Identifier + proyecto: la "metadata" chica, arriba y tenue. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock x:Name="IdText" Foreground="#4FC3F7" FontFamily="Segoe UI" FontSize="11"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="ProjectText" Foreground="#6E6E78" FontFamily="Segoe UI" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <!-- El texto completo de la tarea (en la barra va recortado; acá entero, con wrap). -->
            <TextBlock x:Name="TitleText" Foreground="#F2F2F2" FontFamily="Segoe UI" FontSize="14"
                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />

            <!-- Body de la card / descripción. Renderizamos PLANO (Vikunja viene del HTML strip,
                 Trello es markdown crudo). ScrollViewer con MaxHeight para que descripciones
                 largas no se coman la pantalla — la ventana sigue creciendo, pero hasta ahí. -->
            <Border x:Name="BodyPanel" Background="#0CFFFFFF" CornerRadius="4" Padding="10,8"
                    Margin="0,0,0,14" Visibility="Collapsed">
                <ScrollViewer x:Name="BodyScroller" MaxHeight="600" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="BodyText" Foreground="#C8C8CC" FontFamily="Segoe UI" FontSize="12"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="UnpinBtn"  Content="{loc:Translate TaskDetail.BtnUnpin}"     Width="92" Height="28" Margin="0,0,8,0" />
                <Button x:Name="PickBtn"   Content="{loc:Translate TaskDetail.BtnPickAnother}" Width="92" Height="28" Margin="0,0,8,0" />
                <Button x:Name="OpenBtn"   Content="{loc:Translate TaskDetail.BtnOpen}"        Width="100" Height="28" />
            </StackPanel>

            <TextBlock Foreground="#6E6E78" FontFamily="Segoe UI" FontSize="10" Margin="0,10,0,0"
                       Text="{loc:Translate TaskDetail.Hints}" />
        </StackPanel>
    </Border>
</Window>
