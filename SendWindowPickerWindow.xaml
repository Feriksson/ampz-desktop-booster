<Window x:Class="AmpzDesktopBooster.SendWindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enviar ventana a…"
        Width="480" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Foreground="#F2F2F2" FontSize="14" FontWeight="SemiBold"
                       Margin="0,0,0,2" />
            <TextBlock Foreground="#9A9A9A" FontSize="11" Margin="0,0,0,8"
                       Text="Elegí el escritorio destino (Enter o doble clic). La ventana se mueve y te sigue." />

            <TextBox x:Name="FilterBox" Background="#2A2A2A" Foreground="#F2F2F2"
                     BorderBrush="#444" Padding="6,4" FontSize="13" Margin="0,0,0,8" />

            <ListBox x:Name="DeskList" Height="240" Background="#161616" Foreground="#E6E6EA"
                     BorderBrush="#333" FontSize="13"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <TextBlock Foreground="#6E6E78" FontSize="10" Margin="0,8,0,0"
                       Text="Enter: enviar · Esc: cancelar" />
        </StackPanel>
    </Border>
</Window>
