<Window x:Class="AmpzDesktopBooster.AppShortcutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shortcut"
        Width="480" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Background="#1A1A1A" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34505C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#222" />
                                <Setter Property="Foreground" Value="#555" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F0F0F" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#F2F2F2" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="22,18">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Foreground="#FFD700" FontSize="14" FontWeight="Bold"
                       Margin="0,0,0,14" />

            <TextBlock Text="Combinación de teclas" Foreground="#888" FontSize="12" Margin="0,0,0,3" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="KeyBox" Grid.Column="0" FontFamily="Consolas" FontSize="13"
                         Foreground="#00D4FF" />
                <Button x:Name="CaptureBtn" Grid.Column="1" Width="110" Margin="8,0,0,0"
                        Content="🎯 Capturar" />
            </Grid>

            <TextBlock Text="Descripción" Foreground="#888" FontSize="12" Margin="0,14,0,3" />
            <TextBox x:Name="DescBox" FontSize="13" />

            <TextBlock Text="Filtro de título de ventana (opcional)" Foreground="#888" FontSize="12"
                       Margin="0,14,0,3" />
            <TextBlock x:Name="CurrentTitleHint" Foreground="#5577AA" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,0,3" Visibility="Collapsed" />
            <TextBox x:Name="TitleBox" FontSize="13" />
            <TextBlock Foreground="#666" FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Text="VACÍO → el shortcut aparece SIEMPRE cuando esta app tenga el foco." />
            <TextBlock Foreground="#666" FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                       Text="CON TEXTO → solo aparece cuando el título de la ventana contiene ese texto." />
            <TextBlock Foreground="#666" FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                       Text="Ej: para Chrome, poner 'GitHub' lo muestra solo en pestañas con 'GitHub'." />

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button x:Name="SaveBtn" Width="170" Content="Crear shortcut" />
                <Button x:Name="CancelBtn" Width="100" Margin="10,0,0,0" Content="Cancelar" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
