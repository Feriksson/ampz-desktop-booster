<Window x:Class="AmpzDesktopBooster.ProjectNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notas"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False" Topmost="True"
        MinWidth="480" MinHeight="320"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="HeaderText" Foreground="#FFD700"
                       FontSize="18" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" x:Name="SubHeaderText" Foreground="#9A9A9A"
                       FontSize="11" Margin="0,2,0,10" />

            <TextBox Grid.Row="2" x:Name="NotesBox"
                     Background="#161616" Foreground="#E6E6EA" BorderBrush="#333"
                     FontFamily="Consolas" FontSize="14" Padding="8"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />

            <TextBlock Grid.Row="3" Foreground="#6E6E78" FontSize="10" Margin="0,8,0,0"
                       Text="Ctrl+S: guardar · Esc: guardar y cerrar (auto-guarda si cambió)" />
        </Grid>
    </Border>
</Window>
