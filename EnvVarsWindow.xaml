<Window x:Class="AmpzDesktopBooster.EnvVarsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AmpzDesktopBooster.Services.Localization"
        Title="{loc:Translate Key=EnvVars.Title}"
        Width="1000" Height="640"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        MinWidth="600" MinHeight="400"
        Background="#1E1E1E" UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6E6EA" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4A57" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#262626" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#262626" />
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="BorderBrush" Value="#333" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Foreground="#F2F2F2" FontSize="16" FontWeight="SemiBold"
                       Text="{loc:Translate Key=EnvVars.Heading}" Margin="0,0,0,8" />

            <TextBox Grid.Row="1" x:Name="FilterBox" Background="#2A2A2A" Foreground="#F2F2F2"
                     BorderBrush="#444" Padding="6,4" FontSize="13" Margin="0,0,0,8" />

            <Border Grid.Row="2" Background="#161616" CornerRadius="4" Padding="2">
                <ListView x:Name="VarsList" Background="Transparent" BorderThickness="0" FontSize="13">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{loc:Translate Key=EnvVars.ColVariable}" Width="280" DisplayMemberBinding="{Binding Key}" />
                            <GridViewColumn Header="{loc:Translate Key=EnvVars.ColValue}" Width="660" DisplayMemberBinding="{Binding Value}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <TextBlock Grid.Row="3" Foreground="#6E6E78" FontSize="10" Margin="0,8,0,0"
                       Text="{loc:Translate Key=EnvVars.Hint}" />
        </Grid>
    </Border>
</Window>
